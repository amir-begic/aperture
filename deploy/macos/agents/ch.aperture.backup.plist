<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily backup on a laptop: at login and at 13:00 (run at wake-up if the Mac was asleep then). A laptop is rarely
  awake at night, hence not 03:30 like ../ch.aperture.backup.plist. Installed by install-laptop.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ch.aperture.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__APERTURE_HOME__/app/deploy/macos/backup.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>APERTURE_HOME</key>
        <string>__APERTURE_HOME__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__APERTURE_HOME__/logs/backup.log</string>
    <key>StandardErrorPath</key>
    <string>__APERTURE_HOME__/logs/backup.log</string>
</dict>
</plist>

#!/bin/bash
# Runs as root when the person clicks Install in Aperture-Installer.pkg (built by build-pkg.sh, which puts the release
# next to this script and fills in __FEED_URL__). Everything else happens as the person logged in: unpack the release
# and run its install.sh, with the feed for updates. Output goes to /var/log/install.log.
set -euo pipefail
FEED_URL="__FEED_URL__"
PACKAGE_PATTERN='^aperture-[0-9A-Za-z.-]+-osx-arm64\.tar\.gz$'

fail() { echo "Aperture: $*" >&2; exit 1; }

[[ $(uname -m) == arm64 ]] || fail "Aperture needs a Mac with Apple silicon."
user="$(stat -f %Su /dev/console)"
[[ -n $user && $user != root && $user != loginwindow ]] || fail "Nobody is logged in. Install it from your own account."
uid="$(id -u "$user")"

# In the person's login session (for launchctl and opening the browser), as them.
as_user() { launchctl asuser "$uid" sudo -u "$user" -H "$@"; }

here="$(cd "$(dirname "$0")" && pwd)"
release="$(cd "$here" && ls aperture-*-osx-arm64.tar.gz 2>/dev/null | head -n 1)"
[[ $release =~ $PACKAGE_PATTERN ]] || fail "The installer doesn't contain a release. Download it again."

# The installer's own folder may not be readable for the person; their copy is.
work="$(as_user mktemp -d /tmp/aperture-install.XXXXXX)"
trap 'rm -rf "$work"' EXIT
cp "$here/$release" "$work/$release"
chown "$user" "$work/$release"

echo "Aperture: installing $release for $user"
as_user tar -xzf "$work/$release" -C "$work"
as_user /bin/bash "$work/${release%-osx-arm64.tar.gz}/deploy/macos/install.sh" "$work/$release" "$FEED_URL"

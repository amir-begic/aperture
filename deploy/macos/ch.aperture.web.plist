<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Aperture as a launchd daemon: starts at boot (no login needed), restarts if it stops, runs as your user.
  install.sh fills in the __PLACEHOLDERS__ and installs it to /Library/LaunchDaemons (root-only readable:
  it contains your password hash and the GitHub token for updates).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ch.aperture.web</string>
    <key>UserName</key>
    <string>__USER__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__APERTURE_HOME__/app/Aperture.Web</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__APERTURE_HOME__/app</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ASPNETCORE_ENVIRONMENT</key>
        <string>Production</string>
        <key>ASPNETCORE_URLS</key>
        <string>http://0.0.0.0:__PORT__</string>
        <key>Aperture__DataDirectory</key>
        <string>__APERTURE_HOME__/data</string>
        <key>Auth__Username</key>
        <string>__LOGIN__</string>
        <key>Auth__PasswordHash</key>
        <string>__HASH__</string>
        <key>Updates__Repository</key>
        <string>__REPO__</string>
        <key>Updates__GitHubToken</key>
        <string>__TOKEN__</string>
        <key>DOTNET_gcServer</key>
        <string>0</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__APERTURE_HOME__/logs/aperture.log</string>
    <key>StandardErrorPath</key>
    <string>__APERTURE_HOME__/logs/aperture.log</string>
</dict>
</plist>

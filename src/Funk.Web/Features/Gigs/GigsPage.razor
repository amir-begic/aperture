@page "/gigs"
@inject IDbContextFactory<FunkDbContext> DbFactory
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>Gigs · Funk</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Gigs</RadzenText>
    <RadzenButton Text="New gig" Icon="add" Click="@(() => Navigation.NavigateTo("gigs/new"))" />
</RadzenStack>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="1rem" class="rz-mb-4">
    <RadzenSelectBar TValue="GigPeriod" @bind-Value="_period" @bind-Value:after="LoadAsync" Size="ButtonSize.Small">
        <Items>
            <RadzenSelectBarItem Text="Upcoming" Value="GigPeriod.Upcoming" />
            <RadzenSelectBarItem Text="Past" Value="GigPeriod.Past" />
            <RadzenSelectBarItem Text="All" Value="GigPeriod.All" />
        </Items>
    </RadzenSelectBar>
    <RadzenDropDown TValue="IEnumerable<GigStatus>" @bind-Value="_statuses" @bind-Value:after="LoadAsync"
                    Data="Enum.GetValues<GigStatus>()" Multiple="true" Chips="true"
                    Placeholder="All statuses" class="status-filter" />
    <RadzenTextBox @bind-Value="_search" @bind-Value:after="LoadAsync" Placeholder="Search title, client, venue…" class="search-box" />
</RadzenStack>

<GigGrid Gigs="_gigs" IsLoading="_loading" EmptyText="@EmptyText" />

@code {
    private GigPeriod _period = GigPeriod.Upcoming;
    private IEnumerable<GigStatus> _statuses = [GigStatus.Inquiry, GigStatus.Confirmed, GigStatus.Done];
    private string? _search;
    private List<GigRow> _gigs = [];
    private bool _loading = true;

    private string EmptyText => _period == GigPeriod.Upcoming ? "No upcoming gigs." : "No gigs found.";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        _gigs = await db.Gigs
            .Filter(_period, _statuses.ToList(), _search, Time.GetLocalNow().DateTime)
            .ToRows()
            .ToListAsync();
        _loading = false;
    }
}

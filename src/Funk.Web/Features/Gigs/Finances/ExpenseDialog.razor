@* Adds or edits a cost of a gig. Closes with true when something changed. *@
@using System.ComponentModel.DataAnnotations
@using Funk.Web.Features.Attachments
@inject IDbContextFactory<FunkDbContext> DbFactory
@inject AttachmentStore Store
@inject DialogService Dialogs

@if (_form is not null)
{
    <RadzenTemplateForm TItem="ExpenseForm" Data="_form" Submit="SaveAsync">
        <RadzenStack Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Category" class="w-full">
                        <RadzenDropDown TValue="ExpenseCategory" Name="Category" @bind-Value="_form.Category"
                                        Data="Categories" TextProperty="Text" ValueProperty="Value" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Date" class="w-full">
                        <ChildContent><RadzenDatePicker TValue="DateOnly?" Name="Date" @bind-Value="_form.Date" DateFormat="dd.MM.yyyy" /></ChildContent>
                        <Helper><RadzenDataAnnotationValidator Component="Date" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenFormField Text="Description" class="w-full">
                        <ChildContent><RadzenTextBox Name="Description" @bind-Value="_form.Description" Placeholder="Light set rental" /></ChildContent>
                        <Helper><RadzenDataAnnotationValidator Component="Description" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Vendor (optional)" class="w-full">
                        <ChildContent><RadzenTextBox Name="Vendor" @bind-Value="_form.Vendor" /></ChildContent>
                        <Helper><RadzenDataAnnotationValidator Component="Vendor" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Amount (CHF)" class="w-full">
                        <ChildContent><RadzenNumeric TValue="decimal?" Name="AmountChf" @bind-Value="_form.AmountChf" Format="#,##0.00" ShowUpDown="false" /></ChildContent>
                        <Helper><RadzenDataAnnotationValidator Component="AmountChf" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenCard Variant="Variant.Outlined" class="rz-p-3">
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenSwitch Name="BillToClient" @bind-Value="_form.BillToClient" @bind-Value:after="OnBillToClientChanged" />
                        <RadzenLabel Component="BillToClient" Text="Bill to the client on top of the quote" />
                    </RadzenStack>
                    @if (_form.BillToClient)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap">
                            <RadzenFormField Text="Price for the client (CHF)" Style="flex: 1; min-width: 12rem">
                                <ChildContent><RadzenNumeric TValue="decimal?" Name="BilledChf" @bind-Value="_form.BilledChf" Format="#,##0.00" ShowUpDown="false" /></ChildContent>
                                <Helper>
                                    <RadzenCustomValidator Component="BilledChf" Text="Enter the price you charge the client."
                                                           Validator="@(() => _form.BilledChf > 0)" />
                                </Helper>
                            </RadzenFormField>
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-3 rz-mb-0">@MarkupText</RadzenText>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Covered by the quote.</RadzenText>
                    }
                </RadzenStack>
            </RadzenCard>

            <div>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-1">Receipt</RadzenText>
                <FileField @ref="_receipt" Current="_existingReceipt" ChooseText="Attach receipt" />
            </div>

            @if (_error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">@_error</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" IsBusy="_busy" BusyText="Saving…" />
                <RadzenButton Text="Cancel" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => Dialogs.Close(false))" />
                @if (ExpenseId is not null)
                {
                    <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                  Click="DeleteAsync" Disabled="_busy" class="rz-ms-auto" />
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    [Parameter, EditorRequired]
    public int GigId { get; set; }

    /// <summary>Null to add a new cost.</summary>
    [Parameter]
    public int? ExpenseId { get; set; }

    /// <summary>Pre-filled date for new costs (the gig's date).</summary>
    [Parameter]
    public DateOnly DefaultDate { get; set; }

    private static readonly IReadOnlyList<(string Text, ExpenseCategory Value)> CategoryItems =
    [
        ("Gear rental", ExpenseCategory.GearRental),
        ("Travel", ExpenseCategory.Travel),
        ("Staff", ExpenseCategory.Staff),
        ("Music", ExpenseCategory.Music),
        ("Other", ExpenseCategory.Other),
    ];

    private static readonly List<Option> Categories = CategoryItems.Select(c => new Option(c.Text, c.Value)).ToList();

    private ExpenseForm? _form;
    private Attachment? _existingReceipt;
    private FileField? _receipt;
    private bool _busy;
    private string? _error;

    /// <summary>"Passed on at cost" or the margin you add, so the price is easy to sanity-check.</summary>
    private string MarkupText => (_form!.AmountChf, _form.BilledChf) switch
    {
        ({ } cost, { } billed) when billed == cost => "Passed on at cost.",
        ({ } cost, { } billed) when billed > cost => $"Your margin on it: {Money.FromChf(billed - cost)}",
        ({ } cost, { } billed) => $"Below cost by {Money.FromChf(cost - billed)}.",
        _ => "",
    };

    /// <summary>Start from the cost price when switching billing on; you only change it to add a margin.</summary>
    private void OnBillToClientChanged()
    {
        if (_form!.BillToClient && _form.BilledChf is null)
        {
            _form.BilledChf = _form.AmountChf;
        }
    }

    public static string CategoryText(ExpenseCategory category) =>
        CategoryItems.First(c => c.Value == category).Text;

    protected override async Task OnInitializedAsync()
    {
        if (ExpenseId is null)
        {
            _form = new ExpenseForm { Date = DefaultDate };
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var expense = await db.Expenses.AsNoTracking().Include(e => e.Receipt).SingleAsync(e => e.Id == ExpenseId);
        _existingReceipt = expense.Receipt;
        _form = new ExpenseForm
        {
            Date = expense.Date,
            Category = expense.Category,
            Description = expense.Description,
            Vendor = expense.Vendor,
            AmountChf = expense.Amount.Chf,
            BillToClient = expense.BilledToClient is not null,
            BilledChf = expense.BilledToClient?.Chf,
        };
    }

    private async Task SaveAsync(ExpenseForm form)
    {
        _busy = true;
        _error = null;
        try
        {
            var (added, removed) = await _receipt!.SaveFileAsync(GigId);
            await Store.CommitAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var expense = ExpenseId is null
                    ? db.Expenses.Add(new Expense { GigId = GigId }).Entity
                    : await db.Expenses.SingleAsync(e => e.Id == ExpenseId);

                expense.Date = form.Date!.Value;
                expense.Category = form.Category;
                expense.Description = form.Description.Trim();
                expense.Vendor = form.Vendor?.Trim();
                expense.Amount = Money.FromChf(form.AmountChf!.Value);
                expense.BilledToClient = form.BillToClient ? Money.FromChf(form.BilledChf!.Value) : null;

                if (removed is not null)
                {
                    expense.ReceiptId = null;
                    db.Attachments.Remove(removed);
                }

                if (added is not null)
                {
                    expense.Receipt = added;
                }

                await db.SaveChangesAsync();
            }, added, removed);

            Dialogs.Close(true);
        }
        catch (AttachmentException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var expense = await db.Expenses.Include(e => e.Receipt).SingleAsync(e => e.Id == ExpenseId);
        var receipt = expense.Receipt;
        await Store.CommitAsync(async () =>
        {
            db.Expenses.Remove(expense);
            if (receipt is not null) db.Attachments.Remove(receipt);
            await db.SaveChangesAsync();
        }, added: null, removed: receipt);

        Dialogs.Close(true);
    }

    private sealed class ExpenseForm
    {
        [Required(ErrorMessage = "Choose a date.")]
        public DateOnly? Date { get; set; }

        public ExpenseCategory Category { get; set; } = ExpenseCategory.GearRental;

        [Required, MaxLength(150)]
        public string Description { get; set; } = "";

        [MaxLength(150)]
        public string? Vendor { get; set; }

        [Required(ErrorMessage = "Enter an amount.")]
        [Range(typeof(decimal), "0.01", "1000000", ParseLimitsInInvariantCulture = true, ErrorMessage = "Enter an amount above zero.")]
        public decimal? AmountChf { get; set; }

        public bool BillToClient { get; set; }

        /// <summary>Checked by a custom validator, only when <see cref="BillToClient"/> is on.</summary>
        public decimal? BilledChf { get; set; }
    }

    private sealed record Option(string Text, ExpenseCategory Value);
}

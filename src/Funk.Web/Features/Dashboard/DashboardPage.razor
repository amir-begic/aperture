@page "/"
@using Funk.Web.Features.Finance
@using Funk.Web.Features.Gigs
@inject IDbContextFactory<FunkDbContext> DbFactory
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject Funk.Web.Configuration.FunkPaths Paths
@inject IWebHostEnvironment Environment

<PageTitle>Dashboard · Funk</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Dashboard</RadzenText>
    <RadzenButton Text="New gig" Icon="add" Click="@(() => Navigation.NavigateTo("gigs/new"))" />
</RadzenStack>

@if (_settingsComplete == false)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        Your business details are incomplete. They're needed for invoices.
        <RadzenLink Path="settings" Text="Complete settings" />
    </RadzenAlert>
}

@if (_statement is not null)
{
    <div class="kpi-row rz-mb-6">
        <KpiTile Label="@($"Income {_statement.Year}")" Value="@_statement.TotalIncome.ToString()" Note="received so far" />
        <KpiTile Label="@($"Costs {_statement.Year}")" Value="@((_statement.TotalCosts + _statement.TotalDepreciation).ToString())" Note="incl. depreciation" />
        <KpiTile Label="@($"Result {_statement.Year}")" Value="@_statement.Result.ToString()" Note="@(_statement.Result < Money.Zero ? "loss" : null)" />
        <KpiTile Label="Open invoices" Value="@_openInvoices.ToString()" Note="@(_overdueCount > 0 ? $"{_overdueCount} overdue" : null)" />
    </div>
}

<div class="rz-mb-6">
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">Needs attention</RadzenText>
        @if (_attention is null)
        {
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
        }
        else if (_attention.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2">Nothing to do. All invoices sent and paid, prep on track.</RadzenText>
        }
        else
        {
            <ul class="plain-list attention-list">
                @foreach (var item in _attention)
                {
                    <li class="@($"list-row attention-{item.Level.ToString().ToLowerInvariant()}")">
                        <RadzenIcon Icon="@item.Icon" />
                        <a href="@item.Link" class="list-row-text">
                            <span class="attention-text">@item.Text</span>
                            <span class="attention-detail">@item.Detail</span>
                        </a>
                    </li>
                }
            </ul>
        }
</div>

<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">Next gigs</RadzenText>
<GigGrid Gigs="_upcoming" IsLoading="_upcoming is null" PageSize="null" EmptyText="No upcoming gigs." />

@code {
    private const int UpcomingCount = 5;

    private bool? _settingsComplete;
    private IncomeStatement? _statement;
    private Money _openInvoices;
    private int _overdueCount;
    private List<AttentionItem>? _attention;
    private List<GigRow>? _upcoming;

    protected override async Task OnInitializedAsync()
    {
        var now = Time.GetLocalNow().DateTime;
        var today = DateOnly.FromDateTime(now);
        await using var db = await DbFactory.CreateDbContextAsync();

        var settings = await db.BusinessSettings.AsNoTracking().SingleAsync();
        _settingsComplete = settings.IsComplete;

        _upcoming = await db.Gigs
            .Filter(GigPeriod.Upcoming, [GigStatus.Inquiry, GigStatus.Confirmed], search: null, now)
            .Take(UpcomingCount)
            .ToRowsAsync(db);

        _statement = await IncomeStatement.LoadAsync(db, now.Year);

        // Open amounts of issued invoices, from all years.
        var invoiced = await db.Gigs.Where(g => g.Invoices.Any(i => i.Status == InvoiceStatus.Issued)).ToRowsAsync(db);
        var open = invoiced.Where(g => g.Financials.Outstanding > Money.Zero).ToList();
        _openInvoices = open.Sum(g => g.Financials.Outstanding!.Value);
        _overdueCount = open.Count(g => g.IsPastDue(today));

        _attention = await Attention.ItemsAsync(db, now,
            Funk.Web.Features.Backup.BackupStatus.Read(Paths), expectBackups: !Environment.IsDevelopment());
    }
}

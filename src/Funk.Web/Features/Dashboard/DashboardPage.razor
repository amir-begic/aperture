@page "/"
@using Funk.Web.Features.Gigs
@inject IDbContextFactory<FunkDbContext> DbFactory
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>Dashboard · Funk</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Dashboard</RadzenText>
    <RadzenButton Text="New gig" Icon="add" Click="@(() => Navigation.NavigateTo("gigs/new"))" />
</RadzenStack>

@if (_settingsComplete == false)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        Your business details are incomplete. They're needed for invoices.
        <RadzenLink Path="settings" Text="Complete settings" />
    </RadzenAlert>
}

<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">Next gigs</RadzenText>
<GigGrid Gigs="_upcoming" IsLoading="_upcoming is null" PageSize="null" EmptyText="No upcoming gigs." />

@code {
    private const int UpcomingCount = 5;

    private bool? _settingsComplete;
    private List<GigRow>? _upcoming;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.BusinessSettings.AsNoTracking().SingleAsync();
        _settingsComplete = settings.IsComplete;

        _upcoming = await db.Gigs
            .Filter(GigPeriod.Upcoming, [GigStatus.Inquiry, GigStatus.Confirmed], search: null, Time.GetLocalNow().DateTime)
            .Take(UpcomingCount)
            .ToRows()
            .ToListAsync();
    }
}

@page "/settings"
@inject IDbContextFactory<FunkDbContext> DbFactory
@inject NotificationService Notifications
@inject Funk.Web.Configuration.FunkPaths Paths

<PageTitle>Settings · Funk</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Settings</RadzenText>
<RadzenText class="rz-mb-6">These details appear on your invoices.</RadzenText>

@if (_settings is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenTemplateForm TItem="BusinessSettings" Data="_settings" Submit="SaveAsync">
        <RadzenStack Gap="1.5rem" class="settings-form">
            <RadzenFieldset Text="Business">
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Your name" class="w-full">
                            <ChildContent><RadzenTextBox Name="OwnerName" @bind-Value="_settings.OwnerName" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="OwnerName" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="DJ / business name (optional)" class="w-full">
                            <ChildContent><RadzenTextBox Name="BusinessName" @bind-Value="_settings.BusinessName" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="BusinessName" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>

            <RadzenFieldset Text="Address">
                <RadzenRow>
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Street and number" class="w-full">
                            <ChildContent><RadzenTextBox Name="Street" @bind-Value="_settings.Street" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="Street" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4" SizeMD="3">
                        <RadzenFormField Text="Postal code" class="w-full">
                            <ChildContent><RadzenTextBox Name="PostalCode" @bind-Value="_settings.PostalCode" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="PostalCode" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="8" SizeMD="6">
                        <RadzenFormField Text="City" class="w-full">
                            <ChildContent><RadzenTextBox Name="City" @bind-Value="_settings.City" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="City" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="Country" class="w-full">
                            <ChildContent><RadzenTextBox Name="CountryCode" @bind-Value="_settings.CountryCode" MaxLength="2" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="CountryCode" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>

            <RadzenFieldset Text="Contact">
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Email" class="w-full">
                            <ChildContent><RadzenTextBox Name="Email" @bind-Value="_settings.Email" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="Email" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Phone" class="w-full">
                            <ChildContent><RadzenTextBox Name="Phone" @bind-Value="_settings.Phone" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="Phone" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Website" class="w-full">
                            <ChildContent><RadzenTextBox Name="Website" @bind-Value="_settings.Website" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="Website" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>

            <RadzenFieldset Text="Payment">
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenFormField Text="IBAN" class="w-full">
                            <ChildContent><RadzenTextBox Name="Iban" @bind-Value="_settings.Iban" Placeholder="CH93 0076 2011 6238 5295 7" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="Iban" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Payment terms (days)" class="w-full">
                            <ChildContent><RadzenNumeric TValue="int" Name="PaymentTermsDays" @bind-Value="_settings.PaymentTermsDays" Min="0" Max="365" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="PaymentTermsDays" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>

            <RadzenFieldset Text="VAT (MWST)">
                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenSwitch Name="IsVatRegistered" @bind-Value="_settings.IsVatRegistered" />
                        <RadzenLabel Component="IsVatRegistered" Text="I'm registered for VAT" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption">
                        Registration is required from CHF 100'000 turnover per year. Until then, invoices show no VAT.
                    </RadzenText>

                    @if (_settings.IsVatRegistered)
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenFormField Text="VAT number" class="w-full">
                                    <ChildContent><RadzenTextBox Name="VatNumber" @bind-Value="_settings.VatNumber" Placeholder="CHE-123.456.789 MWST" /></ChildContent>
                                    <Helper>
                                        <RadzenDataAnnotationValidator Component="VatNumber" />
                                        <RadzenCustomValidator Component="VatNumber" Text="Required when registered for VAT."
                                                               Validator="@(() => !string.IsNullOrWhiteSpace(_settings.VatNumber))" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="VAT rate (%)" class="w-full">
                                    <ChildContent><RadzenNumeric TValue="decimal" Name="VatRatePercent" @bind-Value="_settings.VatRatePercent" Min="0" Max="100" Step="0.1" Format="0.0#" /></ChildContent>
                                    <Helper><RadzenDataAnnotationValidator Component="VatRatePercent" /></Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenStack>
            </RadzenFieldset>

            <RadzenFieldset Text="Depreciation of equipment">
                <RadzenStack Gap="0.5rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenSwitch Name="FullFirstYear" Value="@(!_settings.ProRataFirstYear)" ValueChanged="@((bool full) => _settings.ProRataFirstYear = !full)" />
                        <RadzenLabel Component="FullFirstYear" Text="Full annual depreciation in the year of purchase" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                        St. Gallen allows the full rate even for equipment bought late in the year (StB 41 Nr. 1).
                        Switch off to depreciate by month instead, e.g. if your canton requires it.
                    </RadzenText>
                </RadzenStack>
            </RadzenFieldset>

            <div>
                <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" IsBusy="_saving" BusyText="Saving…" />
            </div>
        </RadzenStack>
    </RadzenTemplateForm>

    <Funk.Web.Features.CalendarFeed.CalendarFeedSettings />

    <RadzenFieldset Text="Backups" class="settings-form rz-mt-6">
        @if (_backup is null)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                No backup has run on this machine yet. The nightly backup is set up with deploy/macos/install.sh (see docs/deployment.md).
            </RadzenText>
        }
        else
        {
            <dl class="facts">
                <dt>Last backup</dt>
                <dd>@(_backup.LastSuccess?.LocalDateTime.ToString("dd.MM.yyyy HH:mm") ?? "never succeeded")</dd>
                <dt>Last run</dt>
                <dd>@_backup.LastRun?.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</dd>
                <dt>Saved to</dt>
                <dd>@(_backup.Destinations.Count == 0 ? "–" : string.Join(", ", _backup.Destinations))</dd>
            </dl>
            @foreach (var problem in _backup.Problems)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mt-2 rz-mb-0">@problem</RadzenAlert>
            }
        }
    </RadzenFieldset>

    <Funk.Web.Features.Updates.UpdatesSettings />
}

@code {
    private BusinessSettings? _settings;
    private Funk.Web.Features.Backup.BackupStatus? _backup;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.BusinessSettings.AsNoTracking().SingleAsync();
        _backup = Funk.Web.Features.Backup.BackupStatus.Read(Paths);
    }

    private async Task SaveAsync(BusinessSettings settings)
    {
        _saving = true;
        try
        {
            settings.Iban = Iban.Normalize(settings.Iban);

            await using var db = await DbFactory.CreateDbContextAsync();
            db.BusinessSettings.Update(settings);
            // The feed link has its own buttons; a form loaded before "New link" mustn't bring the old one back.
            db.Entry(settings).Property(s => s.CalendarFeedToken).IsModified = false;
            await db.SaveChangesAsync();

            Notifications.Notify(NotificationSeverity.Success, "Settings saved");
        }
        finally
        {
            _saving = false;
        }
    }
}

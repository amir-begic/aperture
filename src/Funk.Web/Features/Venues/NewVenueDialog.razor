@* Opened from the gig form; closes with the saved venue, or null when cancelled. *@
@inject DialogService Dialogs

<VenueForm Venue="_venue" Compact="true" Saved="@(venue => Dialogs.Close(venue))">
    <Buttons>
        <RadzenButton Text="Cancel" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => Dialogs.Close())" />
    </Buttons>
</VenueForm>

@code {
    private readonly Venue _venue = new();
}

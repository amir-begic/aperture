@page "/venues"
@inject IDbContextFactory<FunkDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Venues · Funk</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Venues</RadzenText>
    <RadzenButton Text="New venue" Icon="add_location_alt" Click="@(() => Navigation.NavigateTo("venues/new"))" />
</RadzenStack>

<RadzenTextBox @bind-Value="_search" Immediate="true" Placeholder="Search name, city…" class="search-box rz-mb-4" />

<RadzenDataGrid TItem="VenueRow" Data="FilteredVenues" IsLoading="_venues is null" AllowSorting="true"
                AllowPaging="true" PageSize="25" EmptyText="No venues yet." class="clickable-rows"
                RowClick="@(args => Navigation.NavigateTo($"venues/{args.Data!.Id}"))">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(VenueRow.Name)" Title="Name" />
        <RadzenDataGridColumn Property="@nameof(VenueRow.Street)" Title="Street" />
        <RadzenDataGridColumn Property="@nameof(VenueRow.City)" Title="City" />
        <RadzenDataGridColumn Property="@nameof(VenueRow.GigCount)" Title="Gigs" Width="6rem" TextAlign="TextAlign.Right" />
    </Columns>
</RadzenDataGrid>

@code {
    private List<VenueRow>? _venues;
    private string? _search;

    private IEnumerable<VenueRow>? FilteredVenues =>
        string.IsNullOrWhiteSpace(_search)
            ? _venues
            : _venues?.Where(v => v.Matches(_search.Trim()));

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _venues = await db.Venues
            .OrderBy(v => v.Name)
            .Select(v => new VenueRow(v.Id, v.Name, v.Street, v.City, v.Gigs.Count))
            .ToListAsync();
    }

    private sealed record VenueRow(int Id, string Name, string? Street, string? City, int GigCount)
    {
        public bool Matches(string search) =>
            new[] { Name, Street, City }
                .Any(value => value?.Contains(search, StringComparison.CurrentCultureIgnoreCase) == true);
    }
}

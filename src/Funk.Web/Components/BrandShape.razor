@* A pink ajvar splat from the Bon Ajvar brand kit. Decoration only: hidden from screen readers. *@
@switch (Kind)
{
    case ShapeKind.Blob:
        <svg class="brand-shape" viewBox="0 0 300 600" width="@Width" style="@Style" aria-hidden="true" focusable="false">
            <path d="M120 20C170 0 230 30 240 90C250 160 200 220 210 300C220 380 270 430 250 500C232 566 160 590 110 560C60 530 90 470 70 410C48 340 20 300 40 220C58 150 60 50 120 20Z" />
        </svg>
        break;
    case ShapeKind.Bean:
        <svg class="brand-shape" viewBox="0 0 200 200" width="@Width" style="@Style" aria-hidden="true" focusable="false">
            <path d="M96 10C140 4 184 34 190 86C196 140 160 190 104 192C52 194 14 160 10 112C6 60 46 16 96 10Z" />
            <path class="ring" d="M88 70C104 62 122 74 120 92C118 110 98 116 86 106C74 96 76 76 88 70Z" />
        </svg>
        break;
    case ShapeKind.Seeds:
        <svg class="brand-shape" viewBox="0 0 120 120" width="@Width" style="@Style" aria-hidden="true" focusable="false">
            <ellipse cx="30" cy="30" rx="14" ry="11" /><ellipse cx="52" cy="46" rx="10" ry="12" />
            <ellipse cx="40" cy="70" rx="12" ry="9" /><ellipse cx="70" cy="74" rx="9" ry="8" />
            <ellipse cx="86" cy="96" rx="13" ry="10" /><circle cx="64" cy="22" r="6" /><circle cx="96" cy="60" r="5" />
        </svg>
        break;
}

@code {
    public enum ShapeKind { Blob, Bean, Seeds }

    [Parameter, EditorRequired]
    public ShapeKind Kind { get; set; }

    [Parameter]
    public int Width { get; set; } = 120;

    /// <summary>Position, e.g. "left: 1rem; bottom: 0".</summary>
    [Parameter]
    public string? Style { get; set; }
}

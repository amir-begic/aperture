@* Same fills as the calendar: inquiry pink and dashed (tentative), confirmed blue, done white, cancelled crossed out. *@
<RadzenBadge BadgeStyle="@Style" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Text="@Status.ToString()"
             class="@(Status == GigStatus.Cancelled ? "badge-cancelled" : null)" />

@code {
    [Parameter, EditorRequired]
    public GigStatus Status { get; set; }

    private BadgeStyle Style => Status switch
    {
        GigStatus.Inquiry => BadgeStyle.Warning,
        GigStatus.Confirmed => BadgeStyle.Info,
        _ => BadgeStyle.Base,
    };
}

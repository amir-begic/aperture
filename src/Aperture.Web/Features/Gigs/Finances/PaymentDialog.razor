@* Records or edits money received for a gig. Closes with true when something changed. *@
@using System.ComponentModel.DataAnnotations
@using Aperture.Web.Features.Attachments
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject AttachmentStore Store
@inject DialogService Dialogs

@if (_form is not null)
{
    <RadzenTemplateForm TItem="PaymentForm" Data="_form" Submit="SaveAsync">
        <RadzenStack Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Amount (CHF)" class="w-full">
                        <ChildContent><RadzenNumeric TValue="decimal?" Name="AmountChf" @bind-Value="_form.AmountChf" Format="#,##0.00" ShowUpDown="false" /></ChildContent>
                        <Helper><RadzenDataAnnotationValidator Component="AmountChf" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Received on" class="w-full">
                        <ChildContent><RadzenDatePicker TValue="DateOnly?" Name="Date" @bind-Value="_form.Date" DateFormat="dd.MM.yyyy" /></ChildContent>
                        <Helper><RadzenDataAnnotationValidator Component="Date" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Method" class="w-full">
                        <RadzenDropDown TValue="PaymentMethod" Name="Method" @bind-Value="_form.Method"
                                        Data="Methods" TextProperty="Text" ValueProperty="Value" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Note (optional)" class="w-full">
                        <ChildContent><RadzenTextBox Name="Note" @bind-Value="_form.Note" Placeholder="Deposit" /></ChildContent>
                        <Helper><RadzenDataAnnotationValidator Component="Note" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <div>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-1">Payslip / proof of payment</RadzenText>
                <FileField @ref="_proof" Current="_existingProof" ChooseText="Attach payslip" />
            </div>

            @if (_error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">@_error</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" IsBusy="_busy" BusyText="Saving…" />
                <RadzenButton Text="Cancel" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => Dialogs.Close(false))" />
                @if (PaymentId is not null)
                {
                    <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                  Click="DeleteAsync" Disabled="_busy" class="rz-ms-auto" />
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    [Parameter, EditorRequired]
    public int GigId { get; set; }

    /// <summary>Null to record a new payment.</summary>
    [Parameter]
    public int? PaymentId { get; set; }

    /// <summary>Pre-filled amount for new payments (what's still outstanding).</summary>
    [Parameter]
    public Money? DefaultAmount { get; set; }

    [Parameter]
    public DateOnly DefaultDate { get; set; }

    private static readonly IReadOnlyList<(string Text, PaymentMethod Value)> MethodItems =
    [
        ("Bank transfer", PaymentMethod.BankTransfer),
        ("TWINT", PaymentMethod.Twint),
        ("Cash", PaymentMethod.Cash),
        ("Other", PaymentMethod.Other),
    ];

    private static readonly List<Option> Methods = MethodItems.Select(m => new Option(m.Text, m.Value)).ToList();

    private PaymentForm? _form;
    private Attachment? _existingProof;
    private FileField? _proof;
    private bool _busy;
    private string? _error;

    public static string MethodText(PaymentMethod method) =>
        MethodItems.First(m => m.Value == method).Text;

    protected override async Task OnInitializedAsync()
    {
        if (PaymentId is null)
        {
            _form = new PaymentForm { Date = DefaultDate, AmountChf = DefaultAmount?.Chf };
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var payment = await db.Payments.AsNoTracking().Include(p => p.Proof).SingleAsync(p => p.Id == PaymentId);
        _existingProof = payment.Proof;
        _form = new PaymentForm
        {
            Date = payment.Date,
            AmountChf = payment.Amount.Chf,
            Method = payment.Method,
            Note = payment.Note,
        };
    }

    private async Task SaveAsync(PaymentForm form)
    {
        _busy = true;
        _error = null;
        try
        {
            var (added, removed) = await _proof!.SaveFileAsync(GigId);
            await Store.CommitAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var payment = PaymentId is null
                    ? db.Payments.Add(new Payment { GigId = GigId }).Entity
                    : await db.Payments.SingleAsync(p => p.Id == PaymentId);

                payment.Date = form.Date!.Value;
                payment.Amount = Money.FromChf(form.AmountChf!.Value);
                payment.Method = form.Method;
                payment.Note = form.Note?.Trim();

                if (removed is not null)
                {
                    payment.ProofId = null;
                    db.Attachments.Remove(removed);
                }

                if (added is not null)
                {
                    payment.Proof = added;
                }

                await db.SaveChangesAsync();
            }, added, removed);

            Dialogs.Close(true);
        }
        catch (AttachmentException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var payment = await db.Payments.Include(p => p.Proof).SingleAsync(p => p.Id == PaymentId);
        var proof = payment.Proof;
        await Store.CommitAsync(async () =>
        {
            db.Payments.Remove(payment);
            if (proof is not null) db.Attachments.Remove(proof);
            await db.SaveChangesAsync();
        }, added: null, removed: proof);

        Dialogs.Close(true);
    }

    private sealed class PaymentForm
    {
        [Required(ErrorMessage = "Enter the date it arrived.")]
        public DateOnly? Date { get; set; }

        [Required(ErrorMessage = "Enter an amount.")]
        [Range(typeof(decimal), "0.01", "1000000", ParseLimitsInInvariantCulture = true, ErrorMessage = "Enter an amount above zero.")]
        public decimal? AmountChf { get; set; }

        public PaymentMethod Method { get; set; } = PaymentMethod.BankTransfer;

        [MaxLength(150)]
        public string? Note { get; set; }
    }

    private sealed record Option(string Text, PaymentMethod Value);
}

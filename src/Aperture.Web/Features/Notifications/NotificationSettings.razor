@* Settings section: notifications on this device and the list of devices that get them (see PushService). *@
@implements IAsyncDisposable
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject PushService Push
@inject IJSRuntime JS
@inject DialogService Dialogs
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject Aperture.Web.Installation.Platform Platform

<RadzenFieldset Text="@L["Notifications"]" class="settings-form rz-mt-6" id="notifications">
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
            @L["Aperture can let you know on this {0} when an invoice becomes overdue, when a delivery is due within a week or overdue, when an inquiry has waited {1} days for an answer, when prep is still open {2} days before a shoot, when a backup fails and when a new version is available. Each only once, between {3:HH:mm} and {4:HH:mm}, and only while this {0} is awake: Aperture sends them itself.",
                L[Platform.Computer], InquiryDays, PrepDays, PushReminders.DayStarts, PushReminders.DayEnds]
        </RadzenText>

        @if (_device is null)
        {
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
        }
        else if (!HasEmail)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
                @L["Add your email under Contact above and save first. Push services (Apple's, Google's, …) only deliver notifications from senders with a contact address."]
            </RadzenAlert>
        }
        else if (!_device.Supported || !_device.Secure)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                @if (!_device.Secure)
                {
                    @L["Notifications need Aperture's own address on this {0}. Open it at {1}.", L[Platform.Computer], $"http://localhost:{new Uri(Navigation.BaseUri).Port}"]
                }
                else
                {
                    @L["This browser can't show notifications from Aperture."]
                }
            </RadzenText>
        }
        else if (_device.Permission == "denied")
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
                @L["Notifications from Aperture are blocked in this browser. Allow them in its settings for this address (Safari: Settings → Websites → Notifications; Chrome and Edge: the icon left of the address)."]
            </RadzenAlert>
        }
        else if (_thisDevice is { } current)
        {
            <div class="push-on">
                <RadzenIcon Icon="notifications_active" />
                <span>@L["Notifications are on for this device ({0}).", current.Device]</span>
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="@L["Send a test"]" Icon="send" Variant="Variant.Outlined" Click="SendTestAsync"
                              IsBusy="_testing" BusyText="@L["Sending…"]" />
                <RadzenButton Text="@L["Turn off on this device"]" Icon="notifications_off" Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Danger" Click="TurnOffAsync" />
            </RadzenStack>
        }
        else
        {
            <div>
                @* Handled in the browser (wwwroot/push.js): the permission prompt has to come from the tap itself. *@
                <RadzenButton Text="@L["Turn on notifications"]" Icon="notifications" data-push-enable="@Push.PublicKey" />
            </div>
        }

        @if (_problem is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">@_problem</RadzenAlert>
        }

        @if (OtherDevices.Any())
        {
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" class="rz-mb-1">@L["Other devices"]</RadzenText>
                <ul class="plain-list push-devices">
                    @foreach (var device in OtherDevices)
                    {
                        <li class="list-row">
                            <RadzenIcon Icon="devices" />
                            <span class="list-row-text">
                                <span>@device.Device</span>
                                <span class="push-device-detail">
                                    @L["Since {0:dd.MM.yyyy}", device.CreatedAt]@(device.LastDeliveredAt is { } last ? $" · {L["last notification {0:dd.MM.yyyy HH:mm}", last]}" : "")
                                </span>
                            </span>
                            <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          title="@L["Remove"]" aria-label="@L["Remove {0}", device.Device]" Click="@(() => RemoveAsync(device))" />
                        </li>
                    }
                </ul>
            </div>
        }
    </RadzenStack>
</RadzenFieldset>

@code {
    /// <summary>Whether Settings has a saved email (see PushService.SubjectAsync).</summary>
    [Parameter]
    public bool HasEmail { get; set; }

    private static readonly int PrepDays = (int)PushReminders.PrepHorizon.TotalDays;

    private static readonly int InquiryDays = Aperture.Web.Features.Dashboard.Attention.InquiryFollowUpDays;

    private IJSObjectReference? _module;
    private DotNetObjectReference<NotificationSettings>? _self;
    private DeviceState? _device;
    private List<PushSubscription> _subscriptions = [];
    private PushSubscription? _thisDevice;
    private string? _problem;
    private bool _testing;

    private IEnumerable<PushSubscription> OtherDevices => _subscriptions.Where(s => s.Id != _thisDevice?.Id);

    /// <summary>What wwwroot/push.js reports about this browser.</summary>
    public sealed record DeviceState(bool Supported, bool Secure, string Permission, BrowserSubscription? Subscription, string Device);

    protected override Task OnInitializedAsync() => LoadSubscriptionsAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./push.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("connect", _self);
        await RefreshDeviceAsync();
        StateHasChanged();
    }

    private async Task RefreshDeviceAsync()
    {
        _device = await _module!.InvokeAsync<DeviceState>("state", Push.PublicKey);
        // A browser that's subscribed is (again) on the list: also after a restore or a renewed subscription.
        _thisDevice = _device.Subscription is { } browser && _device.Permission == "granted"
            ? await Push.SaveAsync(browser, _device.Device)
            : null;
        await LoadSubscriptionsAsync();
    }

    private async Task LoadSubscriptionsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _subscriptions = await db.PushSubscriptions.AsNoTracking().OrderBy(s => s.CreatedAt).ToListAsync();
    }

    [JSInvokable]
    public async Task SubscribedAsync(BrowserSubscription browser, string device)
    {
        _problem = null;
        _thisDevice = await Push.SaveAsync(browser, device);
        _device = _device! with { Permission = "granted", Subscription = browser };
        await LoadSubscriptionsAsync();
        await SendAsync(new PushMessage(L["Notifications are on"], L["Aperture will let you know when something needs doing."], "settings#notifications", "test"));
        StateHasChanged();
    }

    [JSInvokable]
    public void PermissionChanged(string permission)
    {
        _device = _device! with { Permission = permission };
        StateHasChanged();
    }

    [JSInvokable]
    public void Failed(string message)
    {
        _problem = L["Couldn't turn notifications on: {0}", message];
        StateHasChanged();
    }

    private async Task SendTestAsync()
    {
        _testing = true;
        try
        {
            await SendAsync(new PushMessage(L["Test from Aperture"], L["Notifications work on this device."], "settings#notifications", "test"));
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task SendAsync(PushMessage message)
    {
        if (_thisDevice is null)
        {
            return;
        }

        if (await Push.SendAsync(message, _thisDevice.Id) > 0)
        {
            Notifications.Notify(NotificationSeverity.Success, L["Notification sent"], L["It should appear in a few seconds."]);
        }
        else
        {
            Notifications.Notify(NotificationSeverity.Warning, L["Couldn't send the notification"],
                L["The push service didn't take it. Is this {0} online? Details are in the log.", L[Platform.Computer]]);
        }
        await RefreshDeviceAsync();
    }

    private async Task TurnOffAsync()
    {
        if (_thisDevice is not { } current)
        {
            return;
        }

        await _module!.InvokeVoidAsync("unsubscribe");
        await Push.RemoveAsync(current.Id);
        await RefreshDeviceAsync();
        Notifications.Notify(NotificationSeverity.Success, L["Notifications turned off for this device"]);
    }

    private async Task RemoveAsync(PushSubscription device)
    {
        if (await Dialogs.Confirm(L["{0} stops getting notifications from Aperture.", device.Device], L["Remove this device?"],
                new ConfirmOptions { OkButtonText = L["Remove"], CancelButtonText = L["Cancel"] }) == true)
        {
            await Push.RemoveAsync(device.Id);
            await LoadSubscriptionsAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnect");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The tab is gone already.
            }
        }
        _self?.Dispose();
    }
}

@* Edits a client and saves it. Used by the client page and the "new client" dialog on shoots. *@
@inject IDbContextFactory<ApertureDbContext> DbFactory

<RadzenTemplateForm TItem="Client" Data="Client" Submit="SaveAsync">
    <RadzenStack Gap="1rem">
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Name"]" class="w-full">
                    <ChildContent><RadzenTextBox Name="Name" @bind-Value="Client.Name" Placeholder="@L["Anna & Marco Rossi"]" /></ChildContent>
                    <Helper><FieldValidator Component="Name" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Company (optional)"]" class="w-full">
                    <ChildContent><RadzenTextBox Name="Company" @bind-Value="Client.Company" /></ChildContent>
                    <Helper><FieldValidator Component="Company" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Phone"]" class="w-full">
                    <ChildContent><RadzenTextBox Name="Phone" @bind-Value="Client.Phone" /></ChildContent>
                    <Helper><FieldValidator Component="Phone" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="@L["Email"]" class="w-full">
                    <ChildContent><RadzenTextBox Name="Email" @bind-Value="Client.Email" /></ChildContent>
                    <Helper><FieldValidator Component="Email" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        @if (!Compact)
        {
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">@L["Billing address (for invoices)"]</RadzenText>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenFormField Text="@L["Street and number"]" class="w-full">
                        <ChildContent><RadzenTextBox Name="Street" @bind-Value="Client.Street" /></ChildContent>
                        <Helper><FieldValidator Component="Street" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="4" SizeMD="3">
                    <RadzenFormField Text="@L["Postal code"]" class="w-full">
                        <ChildContent><RadzenTextBox Name="PostalCode" @bind-Value="Client.PostalCode" /></ChildContent>
                        <Helper><FieldValidator Component="PostalCode" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="8" SizeMD="6">
                    <RadzenFormField Text="@L["City"]" class="w-full">
                        <ChildContent><RadzenTextBox Name="City" @bind-Value="Client.City" /></ChildContent>
                        <Helper><FieldValidator Component="City" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenFormField Text="@L["Country"]" class="w-full">
                        <ChildContent><RadzenTextBox Name="CountryCode" @bind-Value="Client.CountryCode" MaxLength="2" /></ChildContent>
                        <Helper><FieldValidator Component="CountryCode" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="@L["Invoice language"]" class="w-full">
                        <RadzenDropDown TValue="Language" Name="InvoiceLanguage" @bind-Value="Client.InvoiceLanguage"
                                        Data="Labels.Choices<Language>(l => l.Name())" TextProperty="Text" ValueProperty="Value" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenFormField Text="@L["Notes"]" class="w-full">
                <ChildContent><RadzenTextArea Name="Notes" @bind-Value="Client.Notes" Rows="4" /></ChildContent>
                <Helper><FieldValidator Component="Notes" /></Helper>
            </RadzenFormField>
        }

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Icon="save" IsBusy="_saving" BusyText="@L["Saving…"]" />
            @Buttons
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter, EditorRequired]
    public Client Client { get; set; } = default!;

    /// <summary>Only name and contact fields, for quick entry from the shoot form.</summary>
    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public EventCallback<Client> Saved { get; set; }

    /// <summary>Extra buttons next to "Save".</summary>
    [Parameter]
    public RenderFragment? Buttons { get; set; }

    private bool _saving;

    private async Task SaveAsync(Client client)
    {
        _saving = true;
        try
        {
            client.Name = client.Name.Trim();

            await using var db = await DbFactory.CreateDbContextAsync();
            if (client.Id == 0)
            {
                db.Clients.Add(client);
            }
            else
            {
                db.Clients.Update(client);
            }

            await db.SaveChangesAsync();
            await Saved.InvokeAsync(client);
        }
        finally
        {
            _saving = false;
        }
    }
}

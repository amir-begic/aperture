@* Opened from the shoot form; closes with the saved client, or null when cancelled. *@
@inject DialogService Dialogs

<ClientForm Client="_client" Compact="true" Saved="@(client => Dialogs.Close(client))">
    <Buttons>
        <RadzenButton Text="Cancel" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(() => Dialogs.Close())" />
    </Buttons>
</ClientForm>

@code {
    private readonly Client _client = new();
}

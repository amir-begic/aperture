@page "/clients/new"
@page "/clients/{Id:int}"
@using Aperture.Web.Features.Shoots
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject DialogService Dialogs

<PageTitle>@(IsNew ? "New client" : _title) · Aperture</PageTitle>

<RadzenBreadCrumb class="rz-mb-2">
    <RadzenBreadCrumbItem Path="clients" Text="Clients" />
    <RadzenBreadCrumbItem Text="@(IsNew ? "New client" : _title)" />
</RadzenBreadCrumb>

@if (_notFound)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Client not found</RadzenText>
}
else if (_client is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@(IsNew ? "New client" : _title)</RadzenText>

    <RadzenCard class="form-card rz-mb-6">
        <ClientForm Client="_client" Saved="OnSaved">
            <Buttons>
                @if (!IsNew)
                {
                    <RadzenButton Text="New shoot" Icon="event" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                  Click="@(() => Navigation.NavigateTo($"shoots/new?clientId={Id}"))" />
                    <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                  Disabled="@(_shoots.Count > 0)" Click="DeleteAsync"
                                  title="@(_shoots.Count > 0 ? "Clients with shoots can't be deleted." : null)" />
                }
            </Buttons>
        </ClientForm>
    </RadzenCard>

    @if (!IsNew)
    {
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">Shoots</RadzenText>
        <ShootGrid Shoots="_shoots" ShowClient="false" PageSize="null" EmptyText="No shoots for this client yet." />
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool IsNew => Id is null;

    private Client? _client;
    private string _title = "";
    private List<ShootRow> _shoots = [];
    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            _client = new Client();
            _shoots = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _client = await db.Clients.AsNoTracking().SingleOrDefaultAsync(c => c.Id == Id);
        _notFound = _client is null;
        _title = _client?.Name ?? "";
        _shoots = await db.Shoots.Where(g => g.ClientId == Id).OrderByDescending(g => g.Start).ToRowsAsync(db);
    }

    private void OnSaved(Client client)
    {
        Notifications.Notify(NotificationSeverity.Success, "Client saved");
        if (IsNew)
        {
            Navigation.NavigateTo($"clients/{client.Id}", replace: true);
        }
        else
        {
            _title = client.Name;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.Confirm($"Delete {_title}?", "Delete client",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed != true)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Clients.Where(c => c.Id == Id).ExecuteDeleteAsync();
        Notifications.Notify(NotificationSeverity.Info, $"{_title} deleted");
        Navigation.NavigateTo("clients");
    }
}

@page "/clients/new"
@page "/clients/{Id:int}"
@using Aperture.Web.Features.Shoots
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject DialogService Dialogs

<PageTitle>@(IsNew ? L["New client"] : _title) · Aperture</PageTitle>

<RadzenBreadCrumb class="rz-mb-2">
    <RadzenBreadCrumbItem Path="clients" Text="@L["Clients"]" />
    <RadzenBreadCrumbItem Text="@(IsNew ? L["New client"] : _title)" />
</RadzenBreadCrumb>

@if (_notFound)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Client not found"]</RadzenText>
}
else if (_client is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@(IsNew ? L["New client"] : _title)</RadzenText>

    <RadzenCard class="form-card rz-mb-6">
        <ClientForm Client="_client" Saved="OnSaved">
            <Buttons>
                @if (!IsNew)
                {
                    <RadzenButton Text="@L["New shoot"]" Icon="event" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                  Click="@(() => Navigation.NavigateTo($"shoots/new?clientId={Id}"))" />
                    <RadzenButton Text="@L["Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                  Disabled="@(_shoots.Count > 0)" Click="DeleteAsync"
                                  title="@(_shoots.Count > 0 ? L["Clients with shoots can't be deleted."] : null)" />
                }
            </Buttons>
        </ClientForm>
    </RadzenCard>

    @if (!IsNew)
    {
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">@L["Shoots"]</RadzenText>
        <ShootGrid Shoots="_shoots" ShowClient="false" PageSize="null" EmptyText="@L["No shoots for this client yet."]" />
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool IsNew => Id is null;

    private Client? _client;
    private string _title = "";
    private List<ShootRow> _shoots = [];
    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            _client = new Client();
            _shoots = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _client = await db.Clients.AsNoTracking().SingleOrDefaultAsync(c => c.Id == Id);
        _notFound = _client is null;
        _title = _client?.Name ?? "";
        _shoots = await db.Shoots.Where(s => s.ClientId == Id).OrderByDescending(s => s.Start).ToRowsAsync(db);
    }

    private void OnSaved(Client client)
    {
        Notifications.Notify(NotificationSeverity.Success, L["Client saved"]);
        if (IsNew)
        {
            Navigation.NavigateTo($"clients/{client.Id}", replace: true);
        }
        else
        {
            _title = client.Name;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.Confirm(L["Delete {0}?", _title], L["Delete client"],
            new ConfirmOptions { OkButtonText = L["Delete"], CancelButtonText = L["Cancel"] });
        if (confirmed != true)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Clients.Where(c => c.Id == Id).ExecuteDeleteAsync();
        Notifications.Notify(NotificationSeverity.Info, L["{0} deleted", _title]);
        Navigation.NavigateTo("clients");
    }
}

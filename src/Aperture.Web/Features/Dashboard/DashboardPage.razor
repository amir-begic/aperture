@page "/"
@using Aperture.Web.Features.Finance
@using Aperture.Web.Features.Shoots
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject Aperture.Web.Configuration.AperturePaths Paths
@inject IWebHostEnvironment Environment
@inject Aperture.Web.Features.Updates.UpdateService Updates

<PageTitle>@L["Dashboard"] · Aperture</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">@L["Dashboard"]</RadzenText>
    <RadzenButton Text="@L["New shoot"]" Icon="add" Click="@(() => Navigation.NavigateTo("shoots/new"))" />
</RadzenStack>

@if (_settingsComplete == false)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        @L["Your business details are incomplete. They're needed for invoices."]
        <RadzenLink Path="settings" Text="@L["Complete settings"]" />
    </RadzenAlert>
}

@if (_statement is not null)
{
    <div class="kpi-row rz-mb-6">
        <KpiTile Label="@L["Income {0}", _statement.Year]" Value="@_statement.TotalIncome.ToString()" Note="@L["received so far"]" />
        <KpiTile Label="@L["Costs {0}", _statement.Year]" Value="@((_statement.TotalCosts + _statement.TotalDepreciation).ToString())" Note="@L["incl. depreciation"]" />
        <KpiTile Label="@L["Result {0}", _statement.Year]" Value="@_statement.Result.ToString()" Note="@(_statement.Result < Money.Zero ? L["loss"].Value : null)" />
        <KpiTile Label="@L["Open invoices"]" Value="@_openInvoices.ToString()" Note="@(_overdueCount > 0 ? L["{0} overdue", _overdueCount].Value : null)" />
    </div>
}

<div class="rz-mb-6">
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">@L["Needs attention"]</RadzenText>
        @if (_attention is null)
        {
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
        }
        else if (_attention.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2">@L["Nothing to do. All invoices sent and paid, prep on track."]</RadzenText>
        }
        else
        {
            <ul class="plain-list attention-list">
                @foreach (var item in _attention)
                {
                    <li class="@($"list-row attention-{item.Level.ToString().ToLowerInvariant()}")">
                        <RadzenIcon Icon="@item.Icon" />
                        <a href="@item.Link" class="list-row-text">
                            <span class="attention-text">@item.Text</span>
                            <span class="attention-detail">@item.Detail</span>
                        </a>
                    </li>
                }
            </ul>
        }
</div>

<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">@L["Next shoots"]</RadzenText>
<ShootGrid Shoots="_upcoming" IsLoading="_upcoming is null" PageSize="null" EmptyText="@L["No upcoming shoots."]" />

@code {
    private const int UpcomingCount = 5;

    private bool? _settingsComplete;
    private IncomeStatement? _statement;
    private Money _openInvoices;
    private int _overdueCount;
    private List<AttentionItem>? _attention;
    private List<ShootRow>? _upcoming;

    protected override async Task OnInitializedAsync()
    {
        var now = Time.GetLocalNow().DateTime;
        var today = DateOnly.FromDateTime(now);
        await using var db = await DbFactory.CreateDbContextAsync();

        var settings = await db.BusinessSettings.AsNoTracking().SingleAsync();
        _settingsComplete = settings.IsComplete;

        _upcoming = await db.Shoots
            .Filter(ShootPeriod.Upcoming, [ShootStatus.Inquiry, ShootStatus.Booked], search: null, now)
            .Take(UpcomingCount)
            .ToRowsAsync(db);

        _statement = await IncomeStatement.LoadAsync(db, now.Year);

        // Open amounts of issued invoices, from all years.
        var invoiced = await db.Shoots.Where(s => s.Invoices.Any(i => i.Status == InvoiceStatus.Issued)).ToRowsAsync(db);
        var open = invoiced.Where(s => s.Financials.Outstanding > Money.Zero).ToList();
        _openInvoices = open.Sum(s => s.Financials.Outstanding!.Value);
        _overdueCount = open.Count(s => s.IsPastDue(today));

        _attention = await Attention.ItemsAsync(db, now,
            Aperture.Web.Features.Backup.BackupStatus.Read(Paths), expectBackups: !Environment.IsDevelopment(), update: Updates.Available);
    }
}

@page "/invoices"
@using Aperture.Web.Features.Shoots
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>@L["Invoices"] · Aperture</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Invoices"]</RadzenText>

@if (_rows is not null)
{
    var open = _rows.Where(r => r.Status == InvoiceStatus.Issued && r.Outstanding > Money.Zero).ToList();
    <div class="kpi-row rz-mb-4">
        <KpiTile Label="@L["Open"]" Value="@open.Sum(r => r.Outstanding).ToString()" Note="@(open.Count == 1 ? L["1 invoice"] : L["{0} invoices", open.Count])" />
        <KpiTile Label="@L["Overdue"]" Value="@open.Where(r => r.IsPastDue).Sum(r => r.Outstanding).ToString()"
                 Note="@L["{0} past their due date", open.Count(r => r.IsPastDue)]" />
        <KpiTile Label="@L["Drafts"]" Value="@_rows.Count(r => r.Status == InvoiceStatus.Draft).ToString()" />
    </div>
}

<RadzenText TextStyle="TextStyle.Caption" class="rz-mb-2">@L["Invoices are created on a shoot's Invoice tab. Click one to open its shoot."]</RadzenText>

<RadzenDataGrid TItem="InvoiceRow" Data="_rows" IsLoading="_rows is null" AllowSorting="true" AllowPaging="true" PageSize="25"
                EmptyText="@L["No invoices yet."]" class="clickable-rows"
                RowClick="@(args => Navigation.NavigateTo($"shoots/{args.Data!.ShootId}?tab=invoice"))">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.Number)" Title="@L["Number"]" Width="7rem">
            <Template Context="row">@(row.Number ?? InvoiceStatus.Draft.Text())</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.IssueDate)" Title="@L["Date"]" Width="7rem">
            <Template Context="row">@row.IssueDate.ToString("dd.MM.yyyy")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.ClientName)" Title="@L["Client"]" />
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.ShootTitle)" Title="@L["Shoot"]" />
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.Total)" Title="@L["Total"]" Width="9rem" TextAlign="TextAlign.Right">
            <Template Context="row">@row.Total</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.DueDate)" Title="@L["Due"]" Width="7rem">
            <Template Context="row">@(row.Status == InvoiceStatus.Draft ? "" : row.DueDate.ToString("dd.MM.yyyy"))</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.Status)" Title="@L["Status"]" Width="8.5rem">
            <Template Context="row">
                @if (row.Status == InvoiceStatus.Issued)
                {
                    <PaymentStateBadge State="row.PaymentState" IsPastDue="row.IsPastDue" />
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Base" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Text="@row.Status.Text()" />
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private List<InvoiceRow>? _rows;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var invoices = await db.Invoices.AsNoTracking()
            .Include(i => i.Lines)
            .Include(i => i.Shoot).ThenInclude(s => s.Client)
            .ToListAsync();
        var shootIds = invoices.Select(i => i.ShootId).Distinct().ToList();
        var payments = await db.Payments.Where(p => shootIds.Contains(p.ShootId)).Select(p => new { p.ShootId, p.Amount }).ToListAsync();
        var received = payments.GroupBy(p => p.ShootId).ToDictionary(g => g.Key, g => g.Sum(p => p.Amount));
        var today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

        _rows = invoices
            .Select(i =>
            {
                // Drafts show the client as it is now; issued invoices the frozen copy.
                var clientName = i.Status == InvoiceStatus.Draft ? i.Shoot.Client.Name : i.Client.Company ?? i.Client.Name;
                var financials = new ShootFinancials(null, Money.Zero, received.GetValueOrDefault(i.ShootId), Invoiced: i.Totals.Total);
                return new InvoiceRow(i.ShootId, i.Number, i.Status, i.IssueDate, i.DueDate, clientName, i.Shoot.Title,
                    i.Totals.Total, financials.Outstanding ?? Money.Zero, financials.PaymentState, today);
            })
            .OrderBy(r => r.Status == InvoiceStatus.Draft ? 0 : 1)
            .ThenByDescending(r => r.Number)
            .ToList();
    }

    private sealed record InvoiceRow(
        int ShootId, string? Number, InvoiceStatus Status, DateOnly IssueDate, DateOnly DueDate,
        string ClientName, string ShootTitle, Money Total, Money Outstanding, PaymentState PaymentState, DateOnly Today)
    {
        public bool IsPastDue => Status == InvoiceStatus.Issued && DueDate < Today && Outstanding > Money.Zero;
    }
}

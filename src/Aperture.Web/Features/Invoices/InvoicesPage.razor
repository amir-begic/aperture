@page "/invoices"
@using Aperture.Web.Features.Gigs
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>Invoices · Aperture</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Invoices</RadzenText>

@if (_rows is not null)
{
    var open = _rows.Where(r => r.Status == InvoiceStatus.Issued && r.Outstanding > Money.Zero).ToList();
    <div class="kpi-row rz-mb-4">
        <KpiTile Label="Open" Value="@open.Sum(r => r.Outstanding).ToString()" Note="@($"{open.Count} invoice{(open.Count == 1 ? "" : "s")}")" />
        <KpiTile Label="Overdue" Value="@open.Where(r => r.IsPastDue).Sum(r => r.Outstanding).ToString()"
                 Note="@($"{open.Count(r => r.IsPastDue)} past their due date")" />
        <KpiTile Label="Drafts" Value="@_rows.Count(r => r.Status == InvoiceStatus.Draft).ToString()" />
    </div>
}

<RadzenText TextStyle="TextStyle.Caption" class="rz-mb-2">Invoices are created on a gig's Invoice tab. Click one to open its gig.</RadzenText>

<RadzenDataGrid TItem="InvoiceRow" Data="_rows" IsLoading="_rows is null" AllowSorting="true" AllowPaging="true" PageSize="25"
                EmptyText="No invoices yet." class="clickable-rows"
                RowClick="@(args => Navigation.NavigateTo($"gigs/{args.Data!.GigId}?tab=invoice"))">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.Number)" Title="Number" Width="7rem">
            <Template Context="row">@(row.Number ?? "Draft")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.IssueDate)" Title="Date" Width="7rem">
            <Template Context="row">@row.IssueDate.ToString("dd.MM.yyyy")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.ClientName)" Title="Client" />
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.GigTitle)" Title="Gig" />
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.Total)" Title="Total" Width="9rem" TextAlign="TextAlign.Right">
            <Template Context="row">@row.Total</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.DueDate)" Title="Due" Width="7rem">
            <Template Context="row">@(row.Status == InvoiceStatus.Draft ? "" : row.DueDate.ToString("dd.MM.yyyy"))</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(InvoiceRow.Status)" Title="Status" Width="8.5rem">
            <Template Context="row">
                @if (row.Status == InvoiceStatus.Issued)
                {
                    <PaymentStateBadge State="row.PaymentState" IsPastDue="row.IsPastDue" />
                }
                else
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Base" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Text="@row.Status.ToString()" />
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private List<InvoiceRow>? _rows;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var invoices = await db.Invoices.AsNoTracking()
            .Include(i => i.Lines)
            .Include(i => i.Gig).ThenInclude(g => g.Client)
            .ToListAsync();
        var gigIds = invoices.Select(i => i.GigId).Distinct().ToList();
        var payments = await db.Payments.Where(p => gigIds.Contains(p.GigId)).Select(p => new { p.GigId, p.Amount }).ToListAsync();
        var received = payments.GroupBy(p => p.GigId).ToDictionary(g => g.Key, g => g.Sum(p => p.Amount));
        var today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

        _rows = invoices
            .Select(i =>
            {
                // Drafts show the client as it is now; issued invoices the frozen copy.
                var clientName = i.Status == InvoiceStatus.Draft ? i.Gig.Client.Name : i.Client.Company ?? i.Client.Name;
                var financials = new GigFinancials(null, Money.Zero, received.GetValueOrDefault(i.GigId), Invoiced: i.Totals.Total);
                return new InvoiceRow(i.GigId, i.Number, i.Status, i.IssueDate, i.DueDate, clientName, i.Gig.Title,
                    i.Totals.Total, financials.Outstanding ?? Money.Zero, financials.PaymentState, today);
            })
            .OrderBy(r => r.Status == InvoiceStatus.Draft ? 0 : 1)
            .ThenByDescending(r => r.Number)
            .ToList();
    }

    private sealed record InvoiceRow(
        int GigId, string? Number, InvoiceStatus Status, DateOnly IssueDate, DateOnly DueDate,
        string ClientName, string GigTitle, Money Total, Money Outstanding, PaymentState PaymentState, DateOnly Today)
    {
        public bool IsPastDue => Status == InvoiceStatus.Issued && DueDate < Today && Outstanding > Money.Zero;
    }
}

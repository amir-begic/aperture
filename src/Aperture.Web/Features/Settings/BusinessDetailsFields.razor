@* The business details invoices need: name, address, contact and IBAN. Inside a RadzenTemplateForm of BusinessSettings,
   on the Settings page and on the welcome page after the first login. *@

<RadzenFieldset Text="@L["Business"]">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Your name"]" class="w-full">
                <ChildContent><RadzenTextBox Name="OwnerName" @bind-Value="Settings.OwnerName" /></ChildContent>
                <Helper><FieldValidator Component="OwnerName" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Studio / business name (optional)"]" class="w-full">
                <ChildContent><RadzenTextBox Name="BusinessName" @bind-Value="Settings.BusinessName" /></ChildContent>
                <Helper><FieldValidator Component="BusinessName" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenFieldset>

<RadzenFieldset Text="@L["Address"]">
    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L["Street and number"]" class="w-full">
                <ChildContent><RadzenTextBox Name="Street" @bind-Value="Settings.Street" /></ChildContent>
                <Helper><FieldValidator Component="Street" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="4" SizeMD="3">
            <RadzenFormField Text="@L["Postal code"]" class="w-full">
                <ChildContent><RadzenTextBox Name="PostalCode" @bind-Value="Settings.PostalCode" /></ChildContent>
                <Helper><FieldValidator Component="PostalCode" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="8" SizeMD="6">
            <RadzenFormField Text="@L["City"]" class="w-full">
                <ChildContent><RadzenTextBox Name="City" @bind-Value="Settings.City" /></ChildContent>
                <Helper><FieldValidator Component="City" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="3">
            <RadzenFormField Text="@L["Country"]" class="w-full">
                <ChildContent><RadzenTextBox Name="CountryCode" @bind-Value="Settings.CountryCode" MaxLength="2" /></ChildContent>
                <Helper><FieldValidator Component="CountryCode" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenFieldset>

<RadzenFieldset Text="@L["Contact"]">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Email"]" class="w-full">
                <ChildContent><RadzenTextBox Name="Email" @bind-Value="Settings.Email" /></ChildContent>
                <Helper><FieldValidator Component="Email" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@L["Phone"]" class="w-full">
                <ChildContent><RadzenTextBox Name="Phone" @bind-Value="Settings.Phone" /></ChildContent>
                <Helper><FieldValidator Component="Phone" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L["Website"]" class="w-full">
                <ChildContent><RadzenTextBox Name="Website" @bind-Value="Settings.Website" /></ChildContent>
                <Helper><FieldValidator Component="Website" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenFieldset>

<RadzenFieldset Text="@L["Payment"]">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenFormField Text="IBAN" class="w-full">
                <ChildContent><RadzenTextBox Name="Iban" @bind-Value="Settings.Iban" Placeholder="CH93 0076 2011 6238 5295 7" /></ChildContent>
                <Helper><FieldValidator Component="Iban" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="@L["Payment terms (days)"]" class="w-full">
                <ChildContent><RadzenNumeric TValue="int" Name="PaymentTermsDays" @bind-Value="Settings.PaymentTermsDays" Min="0" Max="365" /></ChildContent>
                <Helper><FieldValidator Component="PaymentTermsDays" /></Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenFieldset>

@code {
    [Parameter, EditorRequired]
    public BusinessSettings Settings { get; set; } = default!;
}

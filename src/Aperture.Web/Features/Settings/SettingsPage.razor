@page "/settings"
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NotificationService Notifications
@inject Aperture.Web.Configuration.AperturePaths Paths

<PageTitle>Settings · Aperture</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Settings</RadzenText>
<RadzenText class="rz-mb-6">These details appear on your invoices.</RadzenText>

@if (_settings is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenTemplateForm TItem="BusinessSettings" Data="_settings" Submit="SaveAsync">
        <RadzenStack Gap="1.5rem" class="settings-form">
            <BusinessDetailsFields Settings="_settings" />

            <RadzenFieldset Text="Delivery">
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Usual delivery time (days)" class="w-full">
                            <ChildContent><RadzenNumeric TValue="int" Name="DeliveryDays" @bind-Value="_settings.DeliveryDays" Min="0" Max="365" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="DeliveryDays" /></Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="8">
                        <RadzenText TextStyle="TextStyle.Caption">
                            New shoots suggest a delivery date this many days after the shoot. You can change it per shoot.
                        </RadzenText>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>

            <RadzenFieldset Text="VAT (MWST)">
                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenSwitch Name="IsVatRegistered" @bind-Value="_settings.IsVatRegistered" />
                        <RadzenLabel Component="IsVatRegistered" Text="I'm registered for VAT" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption">
                        Registration is required from CHF 100'000 turnover per year. Until then, invoices show no VAT.
                    </RadzenText>

                    @if (_settings.IsVatRegistered)
                    {
                        <RadzenRow>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenFormField Text="VAT number" class="w-full">
                                    <ChildContent><RadzenTextBox Name="VatNumber" @bind-Value="_settings.VatNumber" Placeholder="CHE-123.456.789 MWST" /></ChildContent>
                                    <Helper>
                                        <RadzenDataAnnotationValidator Component="VatNumber" />
                                        <RadzenCustomValidator Component="VatNumber" Text="Required when registered for VAT."
                                                               Validator="@(() => !string.IsNullOrWhiteSpace(_settings.VatNumber))" />
                                    </Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="VAT rate (%)" class="w-full">
                                    <ChildContent><RadzenNumeric TValue="decimal" Name="VatRatePercent" @bind-Value="_settings.VatRatePercent" Min="0" Max="100" Step="0.1" Format="0.0#" /></ChildContent>
                                    <Helper><RadzenDataAnnotationValidator Component="VatRatePercent" /></Helper>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenStack>
            </RadzenFieldset>

            <RadzenFieldset Text="Depreciation of equipment">
                <RadzenStack Gap="0.5rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenSwitch Name="FullFirstYear" Value="@(!_settings.ProRataFirstYear)" ValueChanged="@((bool full) => _settings.ProRataFirstYear = !full)" />
                        <RadzenLabel Component="FullFirstYear" Text="Full annual depreciation in the year of purchase" />
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                        St. Gallen allows the full rate even for equipment bought late in the year (StB 41 Nr. 1).
                        Switch off to depreciate by month instead, e.g. if your canton requires it.
                    </RadzenText>
                </RadzenStack>
            </RadzenFieldset>

            <div>
                <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" IsBusy="_saving" BusyText="Saving…" />
            </div>
        </RadzenStack>
    </RadzenTemplateForm>

    <RadzenFieldset Text="Calendar" class="settings-form rz-mt-6">
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
            To put a shoot in your calendar, open it, click <em>Add to calendar</em> and open the downloaded file. It goes
            into your calendar app (Calendar on a Mac, Outlook on Windows, …), and with a synced calendar such as iCloud,
            Google or Outlook onto your phone too. If the date or time changes later, change it in the calendar as well.
        </RadzenText>
    </RadzenFieldset>

    <Aperture.Web.Features.Notifications.NotificationSettings HasEmail="_hasSavedEmail" />

    <RadzenFieldset Text="Backups" class="settings-form rz-mt-6" id="backups">
        @if (_backup is null)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                No backup has run on this computer yet. The installer sets it up, and the first one runs right away.
            </RadzenText>
        }
        else
        {
            <dl class="facts">
                <dt>Last backup</dt>
                <dd>@(_backup.LastSuccess?.LocalDateTime.ToString("dd.MM.yyyy HH:mm") ?? "never succeeded")</dd>
                <dt>Last run</dt>
                <dd>@_backup.LastRun?.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</dd>
                <dt>Saved to</dt>
                <dd>@(_backup.Destinations.Count == 0 ? "–" : string.Join(", ", _backup.Destinations))</dd>
            </dl>
            @foreach (var problem in _backup.Problems)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mt-2 rz-mb-0">@problem</RadzenAlert>
            }
        }
        <RadzenStack Gap="0.5rem" class="rz-mt-4">
            <div>
                @* "download" keeps Blazor from treating it as page navigation. *@
                <a href="backup.zip" download class="rz-button rz-button-md rz-variant-outlined rz-primary export-button">
                    <RadzenIcon Icon="download" /> Download a backup
                </a>
            </div>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                Everything in one ZIP: the database and all uploaded files, with a note on how to restore it. For a copy
                somewhere else, or to move Aperture to a new Mac. Your login isn't in it.
            </RadzenText>
        </RadzenStack>
    </RadzenFieldset>

    <Aperture.Web.Features.Updates.UpdatesSettings />
}

@code {
    private BusinessSettings? _settings;
    private Aperture.Web.Features.Backup.BackupStatus? _backup;
    private bool _saving;
    private bool _hasSavedEmail;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.BusinessSettings.AsNoTracking().SingleAsync();
        _hasSavedEmail = !string.IsNullOrWhiteSpace(_settings.Email);
        _backup = Aperture.Web.Features.Backup.BackupStatus.Read(Paths);
    }

    private async Task SaveAsync(BusinessSettings settings)
    {
        _saving = true;
        try
        {
            settings.Iban = Iban.Normalize(settings.Iban);

            await using var db = await DbFactory.CreateDbContextAsync();
            db.BusinessSettings.Update(settings);
            await db.SaveChangesAsync();
            _hasSavedEmail = !string.IsNullOrWhiteSpace(settings.Email);

            Notifications.Notify(NotificationSeverity.Success, "Settings saved");
        }
        finally
        {
            _saving = false;
        }
    }
}

@page "/finance"
@using System.Globalization
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject TimeProvider Time

<PageTitle>@L["Finance"] · Aperture</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" class="rz-mb-2">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">@L["Finance"]</RadzenText>
    <RadzenFormField Text="@L["Year"]">
        <RadzenDropDown TValue="int" @bind-Value="_year" @bind-Value:after="LoadAsync" Data="_years" />
    </RadzenFormField>
</RadzenStack>
<RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4">
    @L["Cash basis: income counts when it's received, costs when they're paid. Equipment is spread over the years as depreciation."]
</RadzenText>

@if (_statement is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    var s = _statement;
    <div class="kpi-row rz-mb-6">
        <KpiTile Label="@L["Income"]" Value="@s.TotalIncome.ToString()" Note="@(s.Income.Count == 1 ? L["1 payment"] : L["{0} payments", s.Income.Count])" />
        <KpiTile Label="@L["Costs"]" Value="@s.TotalCosts.ToString()" Note="@(s.Expenses.Count == 1 ? L["1 entry"] : L["{0} entries", s.Expenses.Count])" />
        <KpiTile Label="@L["Depreciation"]" Value="@s.TotalDepreciation.ToString()" Note="@(s.Assets.Count == 1 ? L["1 item of equipment"] : L["{0} items of equipment", s.Assets.Count])" />
        <KpiTile Label="@L["Result"]" Value="@s.Result.ToString()"
                 Note="@(s.DisposalResult == Money.Zero ? (s.Result < Money.Zero ? L["loss"].Value : null) : L["incl. equipment sold: {0}", s.DisposalResult])" />
    </div>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-6">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="1rem">
            <RadzenStack Gap="0.25rem" Style="flex: 1; min-width: 16rem">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">@L["Tax export {0}", s.Year]</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                    @L["Income statement, all entries as a spreadsheet, and every receipt, payslip and invoice of the year, numbered to match. For your tax return or fiduciary."]
                </RadzenText>
            </RadzenStack>
            @* "download" keeps Blazor from treating these as page navigation. *@
            <a href="@($"tax/{s.Year}/export.zip")" download class="rz-button rz-button-md rz-variant-filled rz-primary export-button">
                <RadzenIcon Icon="folder_zip" /> @L["Everything (ZIP)"]
            </a>
            <a href="@($"tax/{s.Year}/statement.pdf")" download class="rz-link export-link"><RadzenIcon Icon="picture_as_pdf" /> @L["Statement (PDF)"]</a>
            <a href="@($"tax/{s.Year}/accounts.xlsx")" download class="rz-link export-link"><RadzenIcon Icon="table_view" /> @L["Accounts (Excel)"]</a>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-6">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">@L["Income and costs per month"]</RadzenText>
            <RadzenSelectBar TValue="bool" @bind-Value="_showTable" Size="ButtonSize.Small">
                <Items>
                    <RadzenSelectBarItem Text="@L["Chart"]" Value="false" />
                    <RadzenSelectBarItem Text="@L["Table"]" Value="true" />
                </Items>
            </RadzenSelectBar>
        </RadzenStack>

        @if (_showTable)
        {
            <table class="finance-table">
                <thead><tr><th>@L["Month"]</th><th class="num">@L["Income"]</th><th class="num">@L["Costs"]</th><th class="num">@L["Difference"]</th></tr></thead>
                <tbody>
                    @foreach (var month in s.Months)
                    {
                        <tr>
                            <td>@MonthName(month.Month)</td>
                            <td class="num">@month.Income.ToAmountString()</td>
                            <td class="num">@month.Costs.ToAmountString()</td>
                            <td class="num">@((month.Income - month.Costs).ToAmountString())</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <RadzenChart Style="height: 280px" class="finance-chart">
                <RadzenColumnSeries Data="_months" CategoryProperty="@nameof(MonthPoint.Label)" ValueProperty="@nameof(MonthPoint.Income)"
                                    Title="@L["Income"]" Fill="@Palette.Income" Stroke="@Palette.Income">
                    <TooltipTemplate Context="point">@point.Label · @L["Chart.income"] <strong>@Money.FromChf(point.Income)</strong></TooltipTemplate>
                </RadzenColumnSeries>
                <RadzenColumnSeries Data="_months" CategoryProperty="@nameof(MonthPoint.Label)" ValueProperty="@nameof(MonthPoint.Costs)"
                                    Title="@L["Costs"]" Fill="@Palette.Costs" Stroke="@Palette.Costs">
                    <TooltipTemplate Context="point">@point.Label · @L["Chart.costs"] <strong>@Money.FromChf(point.Costs)</strong></TooltipTemplate>
                </RadzenColumnSeries>
                <RadzenColumnOptions Radius="4" Margin="2" />
                <RadzenValueAxis Formatter="@FormatAxis">
                    <RadzenGridLines Visible="true" />
                </RadzenValueAxis>
                <RadzenCategoryAxis />
                <RadzenLegend Position="LegendPosition.Top" />
            </RadzenChart>
        }
    </RadzenCard>

    <RadzenRow Gap="2rem">
        <RadzenColumn Size="12" SizeLG="6">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">@L["Costs by category"]</RadzenText>
            <table class="finance-table">
                <tbody>
                    @foreach (var (category, amount) in s.CostsByCategory)
                    {
                        <tr>
                            <td>@category.Text()</td>
                            <td class="num">@amount.ToAmountString()</td>
                            <td class="num share">@Share(amount, s.TotalCosts)</td>
                        </tr>
                    }
                    @if (s.TotalDepreciation != Money.Zero)
                    {
                        <tr>
                            <td><RadzenLink Path="equipment" Text="@L["Depreciation of equipment"]" /></td>
                            <td class="num">@s.TotalDepreciation.ToAmountString()</td>
                            <td></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th>@L["Total"]</th><th class="num">@((s.TotalCosts + s.TotalDepreciation).ToAmountString())</th><th></th></tr>
                </tfoot>
            </table>
            <RadzenLink Path="costs" Text="@L["All costs"]" class="rz-mt-2" />
        </RadzenColumn>

    </RadzenRow>

    <RadzenRow class="rz-mt-6">
        <RadzenColumn Size="12">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">@L["Shoots in {0}", s.Year]</RadzenText>
            <RadzenDataGrid TItem="ShootResult" Data="s.Shoots" AllowSorting="true" EmptyText="@L["No shoots in this year."]" class="clickable-rows"
                            RowClick="@(args => Navigation.NavigateTo($"shoots/{args.Data!.ShootId}?tab=finances"))">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(ShootResult.Start)" Title="@L["Date"]" Width="7rem">
                        <Template Context="shoot">@shoot.Start.ToString("dd.MM.")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(ShootResult.Title)" Title="@L["Shoot"]" />
                    <RadzenDataGridColumn Title="@L["To bill"]" TextAlign="TextAlign.Right" Width="8rem">
                        <Template Context="shoot">@shoot.ToBill?.ToAmountString()</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@L["Costs"]" TextAlign="TextAlign.Right" Width="7rem">
                        <Template Context="shoot">@shoot.Costs.ToAmountString()</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@L["Margin"]" TextAlign="TextAlign.Right" Width="8rem">
                        <Template Context="shoot">@shoot.Margin?.ToAmountString()</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@L["Received"]" TextAlign="TextAlign.Right" Width="8rem">
                        <Template Context="shoot">@shoot.Received.ToAmountString()</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    // Monochrome like the rest: black and a mid gray, told apart by lightness (gray 3.4:1 on white).
    private static readonly (string Income, string Costs) Palette = ("#000000", "#8A8A8A");

    private static readonly CultureInfo Swiss = CultureInfo.GetCultureInfo("de-CH");

    private List<int> _years = [];
    private int _year;
    private IncomeStatement? _statement;
    private List<MonthPoint> _months = [];
    private bool _showTable;

    protected override async Task OnInitializedAsync()
    {
        _year = Time.GetLocalNow().Year;
        await using var db = await DbFactory.CreateDbContextAsync();
        _years = await IncomeStatement.YearsAsync(db, _year);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _statement = await IncomeStatement.LoadAsync(db, _year);
        _months = _statement.Months.Select(m => new MonthPoint(MonthName(m.Month)[..3], m.Income.Chf, m.Costs.Chf)).ToList();
    }

    private static string MonthName(int month) => CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month);

    private static string FormatAxis(object value) => Convert.ToDecimal(value).ToString("#,##0", Swiss);

    private static string Share(Money part, Money total) =>
        total == Money.Zero ? "" : $"{part.Rappen * 100m / total.Rappen:0} %";

    private sealed record MonthPoint(string Label, decimal Income, decimal Costs);
}

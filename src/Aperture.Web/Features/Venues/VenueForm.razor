@* Edits a venue and saves it. Used by the venue page and the "new venue" dialog on gigs. *@
@inject IDbContextFactory<ApertureDbContext> DbFactory

<RadzenTemplateForm TItem="Venue" Data="Venue" Submit="SaveAsync">
    <RadzenStack Gap="1rem">
        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenFormField Text="Name" class="w-full">
                    <ChildContent><RadzenTextBox Name="Name" @bind-Value="Venue.Name" /></ChildContent>
                    <Helper><RadzenDataAnnotationValidator Component="Name" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenFormField Text="Street and number" class="w-full">
                    <ChildContent><RadzenTextBox Name="Street" @bind-Value="Venue.Street" /></ChildContent>
                    <Helper><RadzenDataAnnotationValidator Component="Street" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="4" SizeMD="3">
                <RadzenFormField Text="Postal code" class="w-full">
                    <ChildContent><RadzenTextBox Name="PostalCode" @bind-Value="Venue.PostalCode" /></ChildContent>
                    <Helper><RadzenDataAnnotationValidator Component="PostalCode" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="8" SizeMD="9">
                <RadzenFormField Text="City" class="w-full">
                    <ChildContent><RadzenTextBox Name="City" @bind-Value="Venue.City" /></ChildContent>
                    <Helper><RadzenDataAnnotationValidator Component="City" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        @if (!Compact)
        {
            <RadzenFormField Text="Notes (load-in, parking, tech contact, …)" class="w-full">
                <ChildContent><RadzenTextArea Name="Notes" @bind-Value="Venue.Notes" Rows="4" /></ChildContent>
                <Helper><RadzenDataAnnotationValidator Component="Notes" /></Helper>
            </RadzenFormField>
        }

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" IsBusy="_saving" BusyText="Saving…" />
            @Buttons
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter, EditorRequired]
    public Venue Venue { get; set; } = default!;

    /// <summary>Without notes, for quick entry from the gig form.</summary>
    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public EventCallback<Venue> Saved { get; set; }

    /// <summary>Extra buttons next to "Save".</summary>
    [Parameter]
    public RenderFragment? Buttons { get; set; }

    private bool _saving;

    private async Task SaveAsync(Venue venue)
    {
        _saving = true;
        try
        {
            venue.Name = venue.Name.Trim();

            await using var db = await DbFactory.CreateDbContextAsync();
            if (venue.Id == 0)
            {
                db.Venues.Add(venue);
            }
            else
            {
                db.Venues.Update(venue);
            }

            await db.SaveChangesAsync();
            await Saved.InvokeAsync(venue);
        }
        finally
        {
            _saving = false;
        }
    }
}

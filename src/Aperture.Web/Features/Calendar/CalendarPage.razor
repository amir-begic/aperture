@page "/calendar"
@using Aperture.Web.Features.Shoots
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject TooltipService Tooltips
@inject TimeProvider Time
@implements IDisposable

<PageTitle>Calendar · Aperture</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Calendar</RadzenText>
    <RadzenButton Text="New shoot" Icon="add" Click="@(() => Navigation.NavigateTo("shoots/new"))" />
</RadzenStack>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="1rem" class="rz-mb-3">
    <ul class="calendar-legend" aria-label="Legend">
        @foreach (var status in LegendStatuses)
        {
            <li><span class="@($"shoot-swatch shoot-{status.ToString().ToLowerInvariant()}")"></span>@status</li>
        }
    </ul>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-ms-auto">
        <RadzenSwitch Name="ShowCancelled" @bind-Value="_showCancelled" @bind-Value:after="ReloadAsync" />
        <RadzenLabel Component="ShowCancelled" Text="Show cancelled" />
    </RadzenStack>
</RadzenStack>

<RadzenText TextStyle="TextStyle.Caption" class="rz-mb-2">Hover a shoot for details, click it to open it, or click a free day to book a new shoot on that date.</RadzenText>

<RadzenScheduler @ref="_scheduler" TItem="CalendarItem" Data="_items" class="calendar"
                 StartProperty="@nameof(CalendarItem.Start)" EndProperty="@nameof(CalendarItem.End)" TextProperty="@nameof(CalendarItem.Title)"
                 LoadData="LoadAsync" SlotSelect="OnSlotSelect" AppointmentSelect="OnShootSelect" AppointmentRender="OnShootRender"
                 AppointmentMouseEnter="ShowCard" AppointmentMouseLeave="HideCard"
                 TodayText="Today">
    <Template Context="item">
        @item.Shoot.Start.ToString("HH:mm") @item.Shoot.Title
    </Template>
    <ChildContent>
        <RadzenMonthView Text="Month" MaxAppointmentsInSlot="3" MoreText="+{0} more" />
        @* The whole day in hour rows: early starts and late wedding receptions stay visible without scrolling. *@
        <RadzenWeekView Text="Week" TimeFormat="HH:mm" MinutesPerSlot="60" StartTime="TimeSpan.Zero" EndTime="@TimeSpan.FromHours(24)" />
        <RadzenYearPlannerView Text="Year" />
    </ChildContent>
</RadzenScheduler>

@code {
    private static readonly ShootStatus[] LegendStatuses = [ShootStatus.Inquiry, ShootStatus.Booked, ShootStatus.Shot, ShootStatus.Delivered, ShootStatus.Cancelled];

    private RadzenScheduler<CalendarItem>? _scheduler;
    private List<CalendarItem> _items = [];
    private bool _showCancelled;
    private SchedulerLoadDataEventArgs? _lastLoad;

    /// <summary>Checklist progress per shoot, for the hover card.</summary>
    private Dictionary<int, (int Done, int Total)> _prep = [];

    // Called by the scheduler whenever the visible range changes (navigation or view switch).
    private async Task LoadAsync(SchedulerLoadDataEventArgs args)
    {
        _lastLoad = args;
        await using var db = await DbFactory.CreateDbContextAsync();
        var shoots = await db.Shoots
            .InRange(args.Start, args.End, _showCancelled)
            .OrderBy(s => s.Start)
            .ToRowsAsync(db);

        var ids = shoots.Select(s => s.Id).ToList();
        _prep = await db.ChecklistItems
            .Where(i => ids.Contains(i.ShootId))
            .GroupBy(i => i.ShootId)
            .Select(g => new { ShootId = g.Key, Done = g.Count(i => i.IsDone), Total = g.Count() })
            .ToDictionaryAsync(p => p.ShootId, p => (p.Done, p.Total));

        // In the week view hours matter, so show the real end. In month and year views a Saturday-night shoot
        // ending at 03:00 is a Saturday booking: showing it on Sunday too would make a free day look booked.
        var showHours = args.View is RadzenWeekView;
        _items = shoots.Select(shoot => new CalendarItem(shoot, showHours ? shoot.End : Earlier(shoot.End, shoot.Start.Date.AddDays(1)))).ToList();
    }

    private async Task ReloadAsync()
    {
        if (_lastLoad is not null)
        {
            await LoadAsync(_lastLoad);
            await _scheduler!.Reload();
        }
    }

    private static DateTime Earlier(DateTime a, DateTime b) => a < b ? a : b;

    /// <summary>A shoot as the scheduler places it; <see cref="End"/> may be cut off at midnight.</summary>
    private sealed record CalendarItem(ShootRow Shoot, DateTime End)
    {
        public DateTime Start => Shoot.Start;
        public string Title => Shoot.Title;
    }

    private void OnShootSelect(SchedulerAppointmentSelectEventArgs<CalendarItem> args)
    {
        Tooltips.Close();
        Navigation.NavigateTo($"shoots/{args.Data!.Shoot.Id}");
    }

    private void ShowCard(SchedulerAppointmentMouseEventArgs<CalendarItem> args)
    {
        var shoot = args.Data!.Shoot;
        var prep = _prep.TryGetValue(shoot.Id, out var progress) ? progress : ((int, int)?)null;
        Tooltips.Open(args.Element, _ => @<ShootHoverCard Shoot="shoot" Prep="prep" Today="@DateOnly.FromDateTime(Time.GetLocalNow().DateTime)" />, new TooltipOptions
        {
            Position = TooltipPosition.Bottom,
            Delay = 250,       // don't flash cards while moving the mouse across the calendar
            Duration = null,   // stay until the mouse leaves the shoot
            CssClass = "shoot-tooltip",
        });
    }

    private void HideCard(SchedulerAppointmentMouseEventArgs<CalendarItem> args) => Tooltips.Close();

    public void Dispose() => Tooltips.Close();

    private void OnSlotSelect(SchedulerSlotSelectEventArgs args)
    {
        var date = args.Start.ToString("yyyy-MM-dd");
        // Week view slots have a time of day; month and year slots start at midnight.
        var start = args.View is RadzenWeekView ? $"&start={args.Start:HH\\:mm}" : "";
        Navigation.NavigateTo($"shoots/new?date={date}{start}");
    }

    // Radzen puts these attributes on the inner .rz-event-content element.
    private void OnShootRender(SchedulerAppointmentRenderEventArgs<CalendarItem> args) =>
        args.Attributes["class"] = $"shoot-event shoot-{args.Data!.Shoot.Status.ToString().ToLowerInvariant()}";
}

@* The details shown when hovering a shoot in the calendar. *@
@using Aperture.Web.Features.Shoots

<div class="shoot-card">
    <div class="shoot-card-title">@Shoot.Title</div>
    <div class="shoot-card-badges">
        <ShootStatusBadge Status="Shoot.Status" />
        @if (Shoot.PaymentState is { } paymentState)
        {
            <PaymentStateBadge State="paymentState" IsShot="@Shoot.Status.HasTakenPlace()" IsPastDue="@Shoot.IsPastDue(Today)" />
        }
    </div>

    <ul class="shoot-card-facts">
        <li>
            <RadzenIcon Icon="schedule" />
            <span>
                @Shoot.Start.ToString("ddd dd.MM.yyyy") · @ShootSchedule.FormatTimes(Shoot.Start, Shoot.End)
                @if (Shoot.End.Date > Shoot.Start.Date && Shoot.End.TimeOfDay > TimeSpan.Zero)
                {
                    <span class="shoot-card-muted"> (ends next day)</span>
                }
            </span>
        </li>
        <li><RadzenIcon Icon="photo_camera" /><span>@Shoot.ShootType</span></li>
        <li>
            <RadzenIcon Icon="person" />
            <span>
                @Shoot.ClientName
                @if (Shoot.ClientPhone is not null)
                {
                    <span class="shoot-card-muted"> · @Shoot.ClientPhone</span>
                }
            </span>
        </li>
        @if (Shoot.LocationName is not null)
        {
            <li><RadzenIcon Icon="location_on" /><span>@Shoot.Location</span></li>
        }
        @if (Financials.Total is { } total)
        {
            <li>
                <RadzenIcon Icon="payments" />
                <span>
                    @total
                    @if (Financials.Outstanding is { } outstanding && outstanding > Money.Zero && Shoot.Status != ShootStatus.Inquiry)
                    {
                        <span class="shoot-card-muted"> · @outstanding outstanding</span>
                    }
                </span>
            </li>
        }
        @if (Shoot.Status.AwaitsDelivery() && Shoot.DeliveryDue is { } due)
        {
            <li>
                <RadzenIcon Icon="photo_library" />
                <span>
                    Delivery due @due.ToString("ddd dd.MM.yyyy")
                    @if (Shoot.IsDeliveryOverdue(Today))
                    {
                        <span class="delivery-overdue"> · overdue</span>
                    }
                </span>
            </li>
        }
        @if (Prep is { Total: > 0 } prep)
        {
            <li><RadzenIcon Icon="checklist" /><span>@prep.Done of @prep.Total prep tasks done</span></li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired]
    public ShootRow Shoot { get; set; } = default!;

    [Parameter]
    public (int Done, int Total)? Prep { get; set; }

    [Parameter, EditorRequired]
    public DateOnly Today { get; set; }

    private ShootFinancials Financials => Shoot.Financials;
}

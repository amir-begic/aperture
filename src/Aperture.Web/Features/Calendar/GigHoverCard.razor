@* The details shown when hovering a gig in the calendar. *@
@using Aperture.Web.Features.Gigs

<div class="gig-card">
    <div class="gig-card-title">@Gig.Title</div>
    <div class="gig-card-badges">
        <GigStatusBadge Status="Gig.Status" />
        @if (Gig.PaymentState is { } paymentState)
        {
            <PaymentStateBadge State="paymentState" IsPlayed="@(Gig.Status == GigStatus.Done)" IsPastDue="@Gig.IsPastDue(Today)" />
        }
    </div>

    <ul class="gig-card-facts">
        <li>
            <RadzenIcon Icon="schedule" />
            <span>
                @Gig.Start.ToString("ddd dd.MM.yyyy") · @GigSchedule.FormatTimes(Gig.Start, Gig.End)
                @if (Gig.End.Date > Gig.Start.Date && Gig.End.TimeOfDay > TimeSpan.Zero)
                {
                    <span class="gig-card-muted"> (ends next day)</span>
                }
            </span>
        </li>
        <li><RadzenIcon Icon="celebration" /><span>@Gig.EventType</span></li>
        <li>
            <RadzenIcon Icon="person" />
            <span>
                @Gig.ClientName
                @if (Gig.ClientPhone is not null)
                {
                    <span class="gig-card-muted"> · @Gig.ClientPhone</span>
                }
            </span>
        </li>
        @if (Gig.VenueName is not null)
        {
            <li><RadzenIcon Icon="location_on" /><span>@Gig.Venue</span></li>
        }
        @if (Financials.Total is { } total)
        {
            <li>
                <RadzenIcon Icon="payments" />
                <span>
                    @total
                    @if (Financials.Outstanding is { } outstanding && outstanding > Money.Zero && Gig.Status != GigStatus.Inquiry)
                    {
                        <span class="gig-card-muted"> · @outstanding outstanding</span>
                    }
                </span>
            </li>
        }
        @if (Prep is { Total: > 0 } prep)
        {
            <li><RadzenIcon Icon="checklist" /><span>@prep.Done of @prep.Total prep tasks done</span></li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired]
    public GigRow Gig { get; set; } = default!;

    [Parameter]
    public (int Done, int Total)? Prep { get; set; }

    [Parameter, EditorRequired]
    public DateOnly Today { get; set; }

    private GigFinancials Financials => Gig.Financials;
}

@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Aperture.Web.Auth
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject CredentialValidator Credentials
@inject LoginStore Logins
@inject NavigationManager Navigation

<PageTitle>@L["Sign in"] · Aperture</PageTitle>

<div class="login-stack">
<div>
    <p class="login-tagline">@L["Photo office"]</p>
    <h1 class="wordmark login-wordmark"><span class="brand-ring" aria-hidden="true"></span>Aperture</h1>
</div>
<RadzenCard class="login-card">

    @if (_failed)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
            @L["Wrong username or password."]
        </RadzenAlert>
    }

    @* Statically rendered form (no circuit), so the sign-in can set the auth cookie. *@
    <EditForm Model="Input" method="post" FormName="login" OnValidSubmit="SignInAsync" data-autofill>
        <DataAnnotationsValidator />
        <RadzenStack Gap="1rem">
            <label class="login-field">
                @L["Username"]
                <InputText @bind-Value="Input.Username" class="rz-textbox" autocomplete="username" autofocus />
            </label>
            <label class="login-field">
                @L["Password"]
                <InputText @bind-Value="Input.Password" type="password" class="rz-textbox" autocomplete="current-password" />
            </label>
            <label class="login-remember">
                <InputCheckbox @bind-Value="Input.RememberMe" />
                @L["Keep me signed in on this device"]
            </label>
            <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Sign in"]" />
        </RadzenStack>
    </EditForm>
</RadzenCard>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private bool _failed;

    protected override void OnInitialized()
    {
        Input ??= new();
        // First start: there's no login to sign in with yet.
        if (Logins.CanSetUpFrom(HttpContext.Connection.RemoteIpAddress))
        {
            Navigation.NavigateTo("setup");
        }
    }

    private async Task SignInAsync()
    {
        if (!Credentials.IsValid(Input.Username, Input.Password))
        {
            _failed = true;
            Input.Password = ""; // don't echo it back into the HTML
            await Task.Delay(TimeSpan.FromSeconds(1)); // slows down password guessing
            return;
        }

        var identity = new ClaimsIdentity(
            [new Claim(ClaimTypes.Name, Input.Username)],
            CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity),
            new AuthenticationProperties { IsPersistent = Input.RememberMe });

        Navigation.NavigateTo(Aperture.Web.Auth.ReturnUrl.Sanitize(ReturnUrl), forceLoad: true);
    }

    private sealed class LoginInput
    {
        [Required]
        public string Username { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = true;
    }
}

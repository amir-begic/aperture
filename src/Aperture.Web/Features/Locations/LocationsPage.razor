@page "/locations"
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@L["Locations"] · Aperture</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">@L["Locations"]</RadzenText>
    <RadzenButton Text="@L["New location"]" Icon="add_location_alt" Click="@(() => Navigation.NavigateTo("locations/new"))" />
</RadzenStack>

<RadzenTextBox @bind-Value="_search" Immediate="true" Placeholder="@L["Search name, city…"]" class="search-box rz-mb-4" />

<RadzenDataGrid TItem="LocationRow" Data="FilteredLocations" IsLoading="_locations is null" AllowSorting="true"
                AllowPaging="true" PageSize="25" EmptyText="@L["No locations yet."]" class="clickable-rows"
                RowClick="@(args => Navigation.NavigateTo($"locations/{args.Data!.Id}"))">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(LocationRow.Name)" Title="@L["Name"]" />
        <RadzenDataGridColumn Property="@nameof(LocationRow.Street)" Title="@L["Street"]" />
        <RadzenDataGridColumn Property="@nameof(LocationRow.City)" Title="@L["City"]" />
        <RadzenDataGridColumn Property="@nameof(LocationRow.ShootCount)" Title="@L["Shoots"]" Width="6rem" TextAlign="TextAlign.Right" />
    </Columns>
</RadzenDataGrid>

@code {
    private List<LocationRow>? _locations;
    private string? _search;

    private IEnumerable<LocationRow>? FilteredLocations =>
        string.IsNullOrWhiteSpace(_search)
            ? _locations
            : _locations?.Where(l => l.Matches(_search.Trim()));

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _locations = await db.Locations
            .OrderBy(l => l.Name)
            .Select(l => new LocationRow(l.Id, l.Name, l.Street, l.City, l.Shoots.Count))
            .ToListAsync();
    }

    private sealed record LocationRow(int Id, string Name, string? Street, string? City, int ShootCount)
    {
        public bool Matches(string search) =>
            new[] { Name, Street, City }
                .Any(value => value?.Contains(search, StringComparison.CurrentCultureIgnoreCase) == true);
    }
}

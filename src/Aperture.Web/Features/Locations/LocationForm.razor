@* Edits a location and saves it. Used by the location page and the "new location" dialog on shoots. *@
@inject IDbContextFactory<ApertureDbContext> DbFactory

<RadzenTemplateForm TItem="Location" Data="Location" Submit="SaveAsync">
    <RadzenStack Gap="1rem">
        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenFormField Text="Name" class="w-full">
                    <ChildContent><RadzenTextBox Name="Name" @bind-Value="Location.Name" /></ChildContent>
                    <Helper><RadzenDataAnnotationValidator Component="Name" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12">
                <RadzenFormField Text="Street and number" class="w-full">
                    <ChildContent><RadzenTextBox Name="Street" @bind-Value="Location.Street" /></ChildContent>
                    <Helper><RadzenDataAnnotationValidator Component="Street" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="4" SizeMD="3">
                <RadzenFormField Text="Postal code" class="w-full">
                    <ChildContent><RadzenTextBox Name="PostalCode" @bind-Value="Location.PostalCode" /></ChildContent>
                    <Helper><RadzenDataAnnotationValidator Component="PostalCode" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="8" SizeMD="9">
                <RadzenFormField Text="City" class="w-full">
                    <ChildContent><RadzenTextBox Name="City" @bind-Value="Location.City" /></ChildContent>
                    <Helper><RadzenDataAnnotationValidator Component="City" /></Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        @if (!Compact)
        {
            <RadzenFormField Text="Notes (access, parking, best light, permits, …)" class="w-full">
                <ChildContent><RadzenTextArea Name="Notes" @bind-Value="Location.Notes" Rows="4" /></ChildContent>
                <Helper><RadzenDataAnnotationValidator Component="Notes" /></Helper>
            </RadzenFormField>
        }

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="save" IsBusy="_saving" BusyText="Saving…" />
            @Buttons
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter, EditorRequired]
    public Location Location { get; set; } = default!;

    /// <summary>Without notes, for quick entry from the shoot form.</summary>
    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public EventCallback<Location> Saved { get; set; }

    /// <summary>Extra buttons next to "Save".</summary>
    [Parameter]
    public RenderFragment? Buttons { get; set; }

    private bool _saving;

    private async Task SaveAsync(Location location)
    {
        _saving = true;
        try
        {
            location.Name = location.Name.Trim();

            await using var db = await DbFactory.CreateDbContextAsync();
            if (location.Id == 0)
            {
                db.Locations.Add(location);
            }
            else
            {
                db.Locations.Update(location);
            }

            await db.SaveChangesAsync();
            await Saved.InvokeAsync(location);
        }
        finally
        {
            _saving = false;
        }
    }
}

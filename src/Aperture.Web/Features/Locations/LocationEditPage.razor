@page "/locations/new"
@page "/locations/{Id:int}"
@using Aperture.Web.Features.Shoots
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject DialogService Dialogs

<PageTitle>@(IsNew ? L["New location"] : _title) · Aperture</PageTitle>

<RadzenBreadCrumb class="rz-mb-2">
    <RadzenBreadCrumbItem Path="locations" Text="@L["Locations"]" />
    <RadzenBreadCrumbItem Text="@(IsNew ? L["New location"] : _title)" />
</RadzenBreadCrumb>

@if (_notFound)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Location not found"]</RadzenText>
}
else if (_location is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@(IsNew ? L["New location"] : _title)</RadzenText>

    <RadzenCard class="form-card rz-mb-6">
        <LocationForm Location="_location" Saved="OnSaved">
            <Buttons>
                @if (!IsNew)
                {
                    <RadzenButton Text="@L["New shoot"]" Icon="event" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                  Click="@(() => Navigation.NavigateTo($"shoots/new?locationId={Id}"))" />
                    <RadzenButton Text="@L["Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                  Disabled="@(_shoots.Count > 0)" Click="DeleteAsync"
                                  title="@(_shoots.Count > 0 ? L["Locations with shoots can't be deleted."] : null)" />
                }
            </Buttons>
        </LocationForm>
    </RadzenCard>

    @if (!IsNew)
    {
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">@L["Shoots"]</RadzenText>
        <ShootGrid Shoots="_shoots" ShowLocation="false" PageSize="null" EmptyText="@L["No shoots at this location yet."]" />
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool IsNew => Id is null;

    private Location? _location;
    private string _title = "";
    private List<ShootRow> _shoots = [];
    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            _location = new Location();
            _shoots = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _location = await db.Locations.AsNoTracking().SingleOrDefaultAsync(l => l.Id == Id);
        _notFound = _location is null;
        _title = _location?.Name ?? "";
        _shoots = await db.Shoots.Where(s => s.LocationId == Id).OrderByDescending(s => s.Start).ToRowsAsync(db);
    }

    private void OnSaved(Location location)
    {
        Notifications.Notify(NotificationSeverity.Success, L["Location saved"]);
        if (IsNew)
        {
            Navigation.NavigateTo($"locations/{location.Id}", replace: true);
        }
        else
        {
            _title = location.Name;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.Confirm(L["Delete {0}?", _title], L["Delete location"],
            new ConfirmOptions { OkButtonText = L["Delete"], CancelButtonText = L["Cancel"] });
        if (confirmed != true)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Locations.Where(l => l.Id == Id).ExecuteDeleteAsync();
        Notifications.Notify(NotificationSeverity.Info, L["{0} deleted", _title]);
        Navigation.NavigateTo("locations");
    }
}

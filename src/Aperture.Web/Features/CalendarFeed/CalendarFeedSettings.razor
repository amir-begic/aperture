@* Settings section for the calendar subscription link (see CalendarFeedEndpoints). *@
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject DialogService Dialogs
@inject NotificationService Notifications

<RadzenFieldset Text="Calendar on your phone" class="settings-form rz-mt-6">
    @if (!_loaded)
    {
        return;
    }

    @if (_token is null)
    {
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                See your shoots in the calendar on your iPhone or any other calendar app. Aperture makes a private link for it.
                Anyone with the link can see your shoots and your clients' names and phone numbers, so keep it to yourself.
            </RadzenText>
            <div>
                <RadzenButton Text="Create calendar link" Icon="event" Click="CreateAsync" />
            </div>
        </RadzenStack>
    }
    else
    {
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="Your calendar link" class="w-full">
                <ChildContent>
                    <RadzenTextBox Name="CalendarFeedUrl" Value="@FeedUrl" ReadOnly="true" class="feed-url"
                                   onfocus="this.select()" aria-label="Calendar link" />
                </ChildContent>
                <End>
                    @* Copied in the browser (wwwroot/copy.js): iPhones only allow it during the tap itself. *@
                    <button type="button" class="copy-button" data-copy="@FeedUrl" data-copy-status="feed-copy-status"
                            title="Copy link" aria-label="Copy link">
                        <span class="notranslate rzi copy-icon" aria-hidden="true">content_copy</span>
                        <span class="notranslate rzi copied-icon" aria-hidden="true">check</span>
                    </button>
                </End>
            </RadzenFormField>
            <span class="copy-status" id="feed-copy-status" role="status"></span>

            @if (!IsTailscaleAddress)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
                    This link uses the address you opened Aperture with (@Host), so it only works where that address does.
                    Open Settings through your Tailscale address (https://….ts.net) to get a link that works on the go.
                </RadzenAlert>
            }

            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" class="rz-mb-1">On the iPhone</RadzenText>
                <ol class="steps">
                    <li>Copy the link (here, on the phone).</li>
                    <li><em>Settings → Apps → Calendar → Calendar Accounts → Add Account → Other → Add Subscribed Calendar</em>.</li>
                    <li>Paste the link, tap <em>Next</em>, then <em>Save</em>.</li>
                </ol>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                    The calendar shows shoots from the last year on; inquiries are marked as tentative, cancelled shoots are left out.
                    The phone checks for changes about once an hour, and only while Tailscale is on.
                </RadzenText>
            </div>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="New link" Icon="autorenew" Variant="Variant.Outlined" Click="RenewAsync" />
                <RadzenButton Text="Turn off" Icon="link_off" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Click="TurnOffAsync" />
            </RadzenStack>
        </RadzenStack>
    }
</RadzenFieldset>

@code {
    private bool _loaded;
    private string? _token;

    private string FeedUrl => $"{Navigation.BaseUri}calendar/{_token}.ics";

    private string Host => new Uri(Navigation.BaseUri).Host;

    private bool IsTailscaleAddress => Host.EndsWith(".ts.net", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _token = await db.BusinessSettings.Select(s => s.CalendarFeedToken).SingleAsync();
        _loaded = true;
    }

    private Task CreateAsync() => SaveTokenAsync(CalendarFeedToken.New(), "Calendar link created");

    private async Task RenewAsync()
    {
        if (await Dialogs.Confirm("The current link stops working. Phones subscribed to it need the new one.", "Make a new link?",
                new ConfirmOptions { OkButtonText = "New link", CancelButtonText = "Cancel" }) == true)
        {
            await SaveTokenAsync(CalendarFeedToken.New(), "New calendar link created");
        }
    }

    private async Task TurnOffAsync()
    {
        if (await Dialogs.Confirm("The link stops working, and subscribed calendars stop updating.", "Turn off the calendar link?",
                new ConfirmOptions { OkButtonText = "Turn off", CancelButtonText = "Cancel" }) == true)
        {
            await SaveTokenAsync(null, "Calendar link turned off");
        }
    }

    private async Task SaveTokenAsync(string? token, string message)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.BusinessSettings.ExecuteUpdateAsync(s => s.SetProperty(x => x.CalendarFeedToken, token));
        _token = token;
        Notifications.Notify(NotificationSeverity.Success, message);
    }
}

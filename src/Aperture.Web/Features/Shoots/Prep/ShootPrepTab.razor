@inject IDbContextFactory<ApertureDbContext> DbFactory

@if (_links is null || _items is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenRow Gap="2rem">
        <RadzenColumn Size="12" SizeLG="6">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">Moodboard & references</RadzenText>

            @if (_links.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4">No links yet. Paste a Pinterest board, shot list or any other reference below.</RadzenText>
            }
            <ul class="plain-list rz-mb-4">
                @foreach (var link in _links)
                {
                    <li class="list-row">
                        <span class="provider-tag">@LinkProvider.FromUrl(link.Url)</span>
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="list-row-text">@(link.Label ?? link.Url)</a>
                        <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall"
                                      Click="@(() => DeleteLinkAsync(link))" title="Remove link" />
                    </li>
                }
            </ul>

            <RadzenTemplateForm TItem="ReferenceLink" Data="_newLink" Submit="AddLinkAsync">
                <RadzenStack Gap="0.5rem">
                    <RadzenFormField Text="Link" class="w-full">
                        <ChildContent><RadzenTextBox Name="Url" @bind-Value="_newLink.Url" Placeholder="https://pinterest.com/…" /></ChildContent>
                        <Helper><RadzenDataAnnotationValidator Component="Url" /></Helper>
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
                        <RadzenFormField Text="What for? (optional)" Style="flex: 1">
                            <ChildContent><RadzenTextBox Name="Label" @bind-Value="_newLink.Label" Placeholder="Moodboard" /></ChildContent>
                            <Helper><RadzenDataAnnotationValidator Component="Label" /></Helper>
                        </RadzenFormField>
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Add" Icon="add" class="rz-mt-1" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeLG="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">Checklist</RadzenText>
                @if (_items.Count > 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@_items.Count(i => i.IsDone) of @_items.Count done</RadzenText>
                }
            </RadzenStack>

            @if (_items.Count == 0)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-my-4">
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">No tasks yet.</RadzenText>
                    @* The one that fits the shoot type comes first, filled; the others stay available. *@
                    @foreach (var (name, template) in ChecklistTemplates.All.OrderBy(t => t.Name != SuggestedTemplate))
                    {
                        <RadzenButton Text="@($"{name} checklist")" Icon="playlist_add_check" Size="ButtonSize.Small"
                                      Variant="@(name == SuggestedTemplate ? Variant.Filled : Variant.Outlined)"
                                      Click="@(() => AddItemsAsync(template))" />
                    }
                </RadzenStack>
            }
            <ul class="plain-list rz-my-2">
                @foreach (var item in _items)
                {
                    <li class="list-row">
                        <RadzenCheckBox TValue="bool" Value="item.IsDone" Change="@(done => SetDoneAsync(item, done))" Name="@($"item-{item.Id}")" />
                        <RadzenLabel Component="@($"item-{item.Id}")" Text="@item.Text" class="@(item.IsDone ? "list-row-text done" : "list-row-text")" />
                        <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall"
                                      Click="@(() => DeleteItemAsync(item))" title="Remove task" />
                    </li>
                }
            </ul>

            <RadzenTemplateForm TItem="ChecklistItem" Data="_newItem" Submit="AddItemAsync">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
                    <RadzenFormField Text="New task" Style="flex: 1">
                        <ChildContent><RadzenTextBox Name="Text" @bind-Value="_newItem.Text" /></ChildContent>
                        <Helper><RadzenDataAnnotationValidator Component="Text" /></Helper>
                    </RadzenFormField>
                    <RadzenButton ButtonType="ButtonType.Submit" Text="Add" Icon="add" class="rz-mt-1" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    [Parameter, EditorRequired]
    public int ShootId { get; set; }

    [Parameter]
    public ShootType ShootType { get; set; } = ShootType.Other;

    private string? SuggestedTemplate => ChecklistTemplates.For(ShootType);

    private List<ReferenceLink>? _links;
    private List<ChecklistItem>? _items;
    private ReferenceLink _newLink = new();
    private ChecklistItem _newItem = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _links = await db.ReferenceLinks.AsNoTracking().Where(l => l.ShootId == ShootId).OrderBy(l => l.Id).ToListAsync();
        _items = await db.ChecklistItems.AsNoTracking().Where(i => i.ShootId == ShootId)
            .OrderBy(i => i.SortOrder).ThenBy(i => i.Id).ToListAsync();
    }

    private async Task AddLinkAsync(ReferenceLink link)
    {
        link.ShootId = ShootId;
        link.Url = link.Url.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        db.ReferenceLinks.Add(link);
        await db.SaveChangesAsync();
        _links!.Add(link);
        _newLink = new ReferenceLink();
    }

    private async Task DeleteLinkAsync(ReferenceLink link)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.ReferenceLinks.Where(l => l.Id == link.Id).ExecuteDeleteAsync();
        _links!.Remove(link);
    }

    private Task AddItemAsync(ChecklistItem item) => AddItemsAsync([item.Text]);

    private async Task AddItemsAsync(IEnumerable<string> texts)
    {
        var nextOrder = _items!.Count == 0 ? 0 : _items.Max(i => i.SortOrder) + 1;
        var items = texts.Select((text, index) => new ChecklistItem
        {
            ShootId = ShootId,
            Text = text.Trim(),
            SortOrder = nextOrder + index,
        }).ToList();

        await using var db = await DbFactory.CreateDbContextAsync();
        db.ChecklistItems.AddRange(items);
        await db.SaveChangesAsync();
        _items.AddRange(items);
        _newItem = new ChecklistItem();
    }

    private async Task SetDoneAsync(ChecklistItem item, bool done)
    {
        item.IsDone = done;
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.ChecklistItems.Where(i => i.Id == item.Id).ExecuteUpdateAsync(s => s.SetProperty(i => i.IsDone, done));
    }

    private async Task DeleteItemAsync(ChecklistItem item)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.ChecklistItems.Where(i => i.Id == item.Id).ExecuteDeleteAsync();
        _items!.Remove(item);
    }
}

@* Paid / partially paid / unpaid / overdue, always as text (color only reinforces it). *@
@if (State != PaymentState.NoQuote)
{
    <RadzenBadge BadgeStyle="@Style" Variant="Variant.Flat" Shade="Shade.Lighter" IsPill="true" Text="@Text" />
}

@code {
    [Parameter, EditorRequired]
    public PaymentState State { get; set; }

    /// <summary>The shoot has been played: unpaid becomes alarming.</summary>
    [Parameter]
    public bool IsPlayed { get; set; }

    /// <summary>An issued invoice's due date has passed.</summary>
    [Parameter]
    public bool IsPastDue { get; set; }

    private bool IsOpen => State is PaymentState.Unpaid or PaymentState.PartiallyPaid;

    private string Text => State switch
    {
        PaymentState.Paid => "Paid",
        _ when IsPastDue && IsOpen => "Overdue",
        PaymentState.PartiallyPaid => "Partially paid",
        _ => "Unpaid",
    };

    private BadgeStyle Style => State switch
    {
        PaymentState.Paid => BadgeStyle.Success,
        _ when IsPastDue && IsOpen => BadgeStyle.Danger,
        PaymentState.PartiallyPaid => BadgeStyle.Secondary,
        _ when IsPlayed => BadgeStyle.Danger,
        _ => BadgeStyle.Base,
    };
}

@page "/shoots/new"
@page "/shoots/{Id:int}"
@using Aperture.Web.Features.Clients
@using Aperture.Web.Features.Locations
@using Aperture.Web.Features.Attachments
@using Aperture.Web.Features.Shoots.Finances
@using Aperture.Web.Features.Shoots.Prep
@using Aperture.Web.Features.Invoices
@using Aperture.Web.Features.Quotes
@inject IDbContextFactory<ApertureDbContext> DbFactory
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject DialogService Dialogs
@inject TimeProvider Time
@inject AttachmentStore Store

<PageTitle>@(IsNew ? L["New shoot"] : _title) · Aperture</PageTitle>

<RadzenBreadCrumb class="rz-mb-2">
    <RadzenBreadCrumbItem Path="shoots" Text="@L["Shoots"]" />
    <RadzenBreadCrumbItem Text="@(IsNew ? L["New shoot"] : _title)" />
</RadzenBreadCrumb>

@if (_notFound)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Shoot not found"]</RadzenText>
}
else if (_form is null)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@(IsNew ? L["New shoot"] : _title)</RadzenText>

    @if (IsNew)
    {
        @DetailsCard
    }
    else
    {
        @if (_summary is not null)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
                <ShootStatusBadge Status="_summary.Status" />
                @if (_summary.PaymentState is { } paymentState)
                {
                    <PaymentStateBadge State="paymentState" IsShot="@_summary.Status.HasTakenPlace()"
                                       IsPastDue="@_summary.IsPastDue(DateOnly.FromDateTime(Time.GetLocalNow().DateTime))" />
                }
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                    @_summary.Start.ToString("ddd dd.MM.yyyy") · @ShootSchedule.FormatTimes(_summary.Start, _summary.End) · @_summary.ClientName
                    @if (_summary.LocationName is not null)
                    {
                        <span> · @_summary.Location</span>
                    }
                </RadzenText>
                @if (_summary.GalleryUrl is not null)
                {
                    <RadzenLink Path="@_summary.GalleryUrl" Target="_blank" Icon="photo_library" Text="@L["Gallery"]" />
                }
                @* Downloads the shoot as an .ics file for the calendar app ("download" keeps Blazor from treating it as a page). *@
                <a href="@($"shoots/{Id}.ics")" download class="rz-link export-link"><RadzenIcon Icon="event" /> @L["Add to calendar"]</a>
            </RadzenStack>
        }

        <RadzenTabs @bind-SelectedIndex="_tabIndex" RenderMode="TabRenderMode.Server">
            <Tabs>
                <RadzenTabsItem Text="@L["Details"]" Icon="edit_note">
                    @DetailsCard
                </RadzenTabsItem>
                <RadzenTabsItem Text="@L["Quote"]" Icon="request_page">
                    <ShootQuoteTab ShootId="Id!.Value" Changed="ReloadAsync" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="@L["Finances"]" Icon="payments">
                    <ShootFinancesTab ShootId="Id!.Value" Quote="_summary?.QuotedPrice" ShootDate="ShootDate" Changed="LoadSummaryAsync" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="@L["Invoice"]" Icon="request_quote">
                    <ShootInvoiceTab ShootId="Id!.Value" Changed="LoadSummaryAsync" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="@L["Moodboard & prep"]" Icon="palette">
                    <ShootPrepTab ShootId="Id!.Value" ShootType="@(_summary?.ShootType ?? ShootType.Other)" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="@L["Files"]" Icon="folder">
                    <ShootFilesTab ShootId="Id!.Value" />
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    // Only rendered once the shoot is loaded.
    private ShootForm Form => _form!;

    private RenderFragment DetailsCard => @<RadzenCard class="form-card">
    <RadzenTemplateForm @ref="_editForm" TItem="ShootForm" Data="Form" Submit="SaveAsync">
        <RadzenStack Gap="1rem">
            @if (_packages.Count > 0)
            {
                <RadzenFormField Text="@L["Package (optional)"]" class="w-full">
                    <ChildContent>
                        <RadzenDropDown TValue="int?" Name="PackageId" @bind-Value="Form.PackageId" @bind-Value:after="ApplyPackageAsync"
                                        Data="_packageItems" TextProperty="@nameof(LookupItem.Text)" ValueProperty="@nameof(LookupItem.Id)"
                                        AllowClear="true" />
                    </ChildContent>
                    <Helper><RadzenText TextStyle="TextStyle.Caption">@L["Fills in type, quote, end time, delivery date and notes"]</RadzenText></Helper>
                </RadzenFormField>
            }

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenFormField Text="@L["Title"]" class="w-full">
                        <ChildContent><RadzenTextBox Name="Title" @bind-Value="Form.Title" Placeholder="@L["Wedding Anna & Marco"]" /></ChildContent>
                        <Helper><FieldValidator Component="Title" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["Shoot type"]" class="w-full">
                        <RadzenDropDown TValue="ShootType" Name="ShootType" @bind-Value="Form.ShootType"
                                        Data="Labels.Choices<ShootType>(t => t.Text())" TextProperty="Text" ValueProperty="Value" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenFormField Text="@L["Client"]" class="w-full">
                        <ChildContent>
                            <RadzenDropDown TValue="int?" Name="ClientId" @bind-Value="Form.ClientId" Data="_clients"
                                            TextProperty="@nameof(LookupItem.Text)" ValueProperty="@nameof(LookupItem.Id)"
                                            AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            FilterOperator="StringFilterOperator.Contains" />
                        </ChildContent>
                        <End>
                            <RadzenButton Icon="person_add" Variant="Variant.Text" Size="ButtonSize.Small"
                                          Click="NewClientAsync" title="@L["New client"]" />
                        </End>
                        <Helper><FieldValidator Component="ClientId" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["Status"]" class="w-full">
                        <RadzenDropDown TValue="ShootStatus" Name="Status" @bind-Value="Form.Status" @bind-Value:after="CheckOverlapsAsync"
                                        Data="Labels.Choices<ShootStatus>(s => s.Text())" TextProperty="Text" ValueProperty="Value" />
                    </RadzenFormField>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["Date"]" class="w-full">
                        <ChildContent>
                            <RadzenDatePicker TValue="DateOnly?" Name="Date" @bind-Value="Form.Date" @bind-Value:after="OnDateChangedAsync"
                                              DateFormat="ddd dd.MM.yyyy" />
                        </ChildContent>
                        <Helper><FieldValidator Component="Date" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="2">
                    <RadzenFormField Text="@L["Start"]" class="w-full">
                        <InputDate Type="InputDateType.Time" @bind-Value="Form.StartTime" @bind-Value:after="CheckOverlapsAsync"
                                   class="rz-textbox time-input" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="2">
                    <RadzenFormField Text="@L["End"]" class="w-full">
                        <ChildContent>
                            <InputDate Type="InputDateType.Time" @bind-Value="Form.EndTime" @bind-Value:after="CheckOverlapsAsync"
                                       class="rz-textbox time-input" />
                        </ChildContent>
                        <Helper>
                            @if (Form.EndsNextDay)
                            {
                                <RadzenText TextStyle="TextStyle.Caption">@L["ends next day"]</RadzenText>
                            }
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["Quote (CHF)"]" class="w-full">
                        <ChildContent>
                            <RadzenNumeric TValue="decimal?" Name="QuotedPriceChf" @bind-Value="Form.QuotedPriceChf"
                                           Format="#,##0.00" Min="0" ShowUpDown="false" />
                        </ChildContent>
                        <Helper><FieldValidator Component="QuotedPriceChf" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            @if (_overlaps.Count > 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-my-0">
                    @L["Overlaps with"]
                    @foreach (var (shoot, index) in _overlaps.Select((shoot, index) => (shoot, index)))
                    {
                        @(index > 0 ? ", " : " ")
                        <RadzenLink Path="@($"shoots/{shoot.Id}")" Text="@shoot.Title" />
                        <span> (@shoot.Start.ToString("ddd dd.MM."), @ShootSchedule.FormatTimes(shoot.Start, shoot.End))</span>
                    }
                </RadzenAlert>
            }

            <RadzenFormField Text="@L["Location (optional)"]" class="w-full">
                <ChildContent>
                    <RadzenDropDown TValue="int?" Name="LocationId" @bind-Value="Form.LocationId" Data="_locations"
                                    TextProperty="@nameof(LookupItem.Text)" ValueProperty="@nameof(LookupItem.Id)"
                                    AllowFiltering="true" AllowClear="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    FilterOperator="StringFilterOperator.Contains" />
                </ChildContent>
                <End>
                    <RadzenButton Icon="add_location_alt" Variant="Variant.Text" Size="ButtonSize.Small"
                                  Click="NewLocationAsync" title="@L["New location"]" />
                </End>
            </RadzenFormField>

            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="@L["Delivery due"]" class="w-full">
                        <ChildContent>
                            <RadzenDatePicker TValue="DateOnly?" Name="DeliveryDue" @bind-Value="Form.DeliveryDue" DateFormat="ddd dd.MM.yyyy"
                                              AllowClear="true" />
                        </ChildContent>
                        <Helper><RadzenText TextStyle="TextStyle.Caption">@L["{0} days after the shoot unless you change it", DeliveryDays]</RadzenText></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenFormField Text="@L["Gallery link (optional)"]" class="w-full">
                        <ChildContent><RadzenTextBox Name="GalleryUrl" @bind-Value="Form.GalleryUrl" Placeholder="https://…" /></ChildContent>
                        <Helper><FieldValidator Component="GalleryUrl" /></Helper>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenFormField Text="@L["Notes"]" class="w-full">
                <ChildContent><RadzenTextArea Name="Notes" @bind-Value="Form.Notes" Rows="5" /></ChildContent>
                <Helper><FieldValidator Component="Notes" /></Helper>
            </RadzenFormField>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Icon="save" IsBusy="_saving" BusyText="@L["Saving…"]" />
                @if (!IsNew)
                {
                    <RadzenButton Text="@L["Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="DeleteAsync"
                                  Disabled="_hasFinancialRecords"
                                  title="@(_hasFinancialRecords ? L["Shoots with costs or payments can't be deleted. Set the status to Cancelled instead."] : null)" />
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenCard>;

    // Pre-fill from links such as "New shoot" on a client page or a calendar day.
    [SupplyParameterFromQuery(Name = "clientId")]
    private int? InitialClientId { get; set; }

    [SupplyParameterFromQuery(Name = "locationId")]
    private int? InitialLocationId { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    private DateOnly? InitialDate { get; set; }

    /// <summary>Start time from a week-view slot; the end is then set a typical shoot length later.</summary>
    [SupplyParameterFromQuery(Name = "start")]
    private TimeOnly? InitialStart { get; set; }

    private static readonly TimeSpan TypicalShootLength = TimeSpan.FromHours(4);

    /// <summary>Opens a tab directly, e.g. ?tab=finances.</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    private string? InitialTab { get; set; }

    private static readonly string[] TabNames = ["details", "quote", "finances", "invoice", "prep", "files"];

    private bool IsNew => Id is null;

    private ShootForm? _form;
    private RadzenTemplateForm<ShootForm>? _editForm;
    private string _title = "";
    private List<LookupItem> _clients = [];
    private List<LookupItem> _locations = [];
    private Dictionary<int, Package> _packages = [];
    private List<LookupItem> _packageItems = [];
    private List<ShootRow> _overlaps = [];
    private int _deliveryDays;
    private DateOnly? _lastDate;
    private bool _notFound;
    private bool _saving;

    /// <summary>The shoot as last saved: header line, quote and date for the tabs.</summary>
    private ShootRow? _summary;
    private bool _hasFinancialRecords;
    private int _tabIndex;

    private DateOnly ShootDate => _summary is null ? default : DateOnly.FromDateTime(_summary.Start);

    protected override async Task OnParametersSetAsync()
    {
        await LoadLookupsAsync();

        if (IsNew)
        {
            _form = new ShootForm { ClientId = InitialClientId, LocationId = InitialLocationId, Date = InitialDate };
            _form.SuggestDeliveryDue(previousDate: null, DeliveryDays);
            _lastDate = _form.Date;
            if (InitialStart is { } start)
            {
                _form.StartTime = start;
                _form.EndTime = start.Add(TypicalShootLength);
            }
        }
        else
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var shoot = await db.Shoots.AsNoTracking().SingleOrDefaultAsync(s => s.Id == Id);
            _notFound = shoot is null;
            _form = shoot is null ? null : ShootForm.From(shoot);
            _title = shoot?.Title ?? "";
            _lastDate = _form?.Date;
            _tabIndex = Math.Max(0, Array.IndexOf(TabNames, InitialTab?.ToLowerInvariant()));
            await LoadSummaryAsync();
        }

        await CheckOverlapsAsync();
    }

    /// <summary>After a quote was answered: status and price may have changed, so the form shows them anew too.</summary>
    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Shoots.AsNoTracking().SingleOrDefaultAsync(s => s.Id == Id) is { } shoot)
        {
            _form = ShootForm.From(shoot);
            _lastDate = _form.Date;
        }
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _summary = (await db.Shoots.Where(s => s.Id == Id).ToRowsAsync(db)).SingleOrDefault();
        _hasFinancialRecords = await db.HasFinancialRecordsAsync(Id!.Value);
    }

    private async Task LoadLookupsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _clients = await db.Clients
            .OrderBy(c => c.Name)
            .Select(c => new LookupItem(c.Id, c.Company == null ? c.Name : c.Name + " (" + c.Company + ")"))
            .ToListAsync();
        _locations = await db.Locations
            .OrderBy(l => l.Name)
            .Select(l => new LookupItem(l.Id, l.City == null ? l.Name : l.Name + ", " + l.City))
            .ToListAsync();
        _deliveryDays = await db.BusinessSettings.Select(s => s.DeliveryDays).SingleAsync();
        _packages = await db.Packages.AsNoTracking().ToDictionaryAsync(p => p.Id);
        _packageItems = _packages.Values.OrderBy(p => p.Name).Select(p => new LookupItem(p.Id, $"{p.Name} · {p.Price}")).ToList();
    }

    /// <summary>The chosen package's delivery time, or the usual one from Settings.</summary>
    private int DeliveryDays =>
        _form?.PackageId is { } id && _packages.GetValueOrDefault(id)?.DeliveryDays is { } days ? days : _deliveryDays;

    private async Task ApplyPackageAsync()
    {
        if (_form!.PackageId is { } id && _packages.TryGetValue(id, out var package))
        {
            _form.ApplyPackage(package, _deliveryDays);
            await CheckOverlapsAsync();
        }
    }

    private async Task OnDateChangedAsync()
    {
        _form!.SuggestDeliveryDue(_lastDate, DeliveryDays);
        _lastDate = _form.Date;
        await CheckOverlapsAsync();
    }

    private async Task CheckOverlapsAsync()
    {
        if (_form?.Range is not { } range || _form.Status == ShootStatus.Cancelled)
        {
            _overlaps = [];
            return;
        }

        var (start, end) = range;
        await using var db = await DbFactory.CreateDbContextAsync();
        _overlaps = await db.Shoots.Overlapping(start, end, Id).OrderBy(s => s.Start).ToRows().ToListAsync();
    }

    private async Task NewClientAsync()
    {
        if (await Dialogs.OpenAsync<NewClientDialog>(L["New client"], options: new DialogOptions { Width = "40rem" }) is Client client)
        {
            await LoadLookupsAsync();
            var form = _form!;
            form.ClientId = client.Id;
            // Set in code, not by the dropdown, so tell the form to re-validate (clears "Choose a client.").
            _editForm?.EditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => form.ClientId));
        }
    }

    private async Task NewLocationAsync()
    {
        if (await Dialogs.OpenAsync<NewLocationDialog>(L["New location"], options: new DialogOptions { Width = "40rem" }) is Location location)
        {
            await LoadLookupsAsync();
            _form!.LocationId = location.Id;
        }
    }

    private async Task SaveAsync(ShootForm form)
    {
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            Shoot shoot;
            if (IsNew)
            {
                shoot = new Shoot { CreatedAt = Time.GetLocalNow().DateTime };
                db.Shoots.Add(shoot);
            }
            else
            {
                shoot = await db.Shoots.SingleAsync(s => s.Id == Id);
            }

            form.ApplyTo(shoot);
            await db.SaveChangesAsync();

            Notifications.Notify(NotificationSeverity.Success, L["Shoot saved"]);
            _title = shoot.Title;
            if (IsNew)
            {
                Navigation.NavigateTo($"shoots/{shoot.Id}", replace: true);
            }
            else
            {
                await LoadSummaryAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.Confirm(
            L["Delete {0}? Consider setting it to Cancelled instead to keep it in your records.", _title],
            L["Delete shoot"],
            new ConfirmOptions { OkButtonText = L["Delete"], CancelButtonText = L["Keep"] });
        if (confirmed != true)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.DeleteShootAsync(Id!.Value, Store);
        Notifications.Notify(NotificationSeverity.Info, L["{0} deleted", _title]);
        Navigation.NavigateTo("shoots");
    }

    private sealed record LookupItem(int Id, string Text);
}

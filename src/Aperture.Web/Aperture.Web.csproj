<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The UI is English: skip libraries' translated messages (de, es, fr, …) in the published app. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <!-- No console window: scheduled tasks start Aperture at logon, and a window would stay open. It logs to a file
         instead (Aperture:LogFile, set by the install command). Not with OutputType WinExe: the Blazor script
         (_framework/blazor.web.js) is only added to Exe builds, and without it no page is interactive. So it stays an
         Exe, and only its program file is marked as a windowed one (the SDK's own switch for WinExe; publish.sh checks
         that the script is there). -->
    <_UseWindowsGraphicalUserInterface>true</_UseWindowsGraphicalUserInterface>
    <!-- Shown for the program, its shortcuts and in Settings → Apps. Made by deploy/icons/make_icons.py. -->
    <ApplicationIcon>..\..\deploy\icons\aperture.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Codecrete.SwissQRBill.Generator" Version="3.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Radzen.Blazor" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Liberation Sans (SIL OFL 1.1), one of the fonts the Swiss QR-bill standard allows. -->
    <EmbeddedResource Include="Features/Invoices/Fonts/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The development data directory (Aperture:DataDirectory = data): database, login and keys. Never part of a build. -->
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>

</Project>

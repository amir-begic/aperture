@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" />
            <a href="" class="wordmark header-wordmark">Aperture</a>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-px-4" Style="flex: 1">
                <form action="logout" method="post">
                    <AntiforgeryToken />
                    <RadzenButton ButtonType="ButtonType.Submit" Icon="logout" Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Base" title="Sign out" />
                </form>
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="_sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/" Match="NavLinkMatch.All" />
            <RadzenPanelMenuItem Text="Calendar" Icon="calendar_month" Path="calendar" />
            <RadzenPanelMenuItem Text="Shoots" Icon="album" Path="shoots" />
            <RadzenPanelMenuItem Text="Invoices" Icon="request_quote" Path="invoices" />
            <RadzenPanelMenuItem Text="Finance" Icon="monitoring" Path="finance" />
            <RadzenPanelMenuItem Text="Costs" Icon="receipt_long" Path="costs" />
            <RadzenPanelMenuItem Text="Equipment" Icon="speaker" Path="equipment" />
            <RadzenPanelMenuItem Text="Clients" Icon="group" Path="clients" />
            <RadzenPanelMenuItem Text="Locations" Icon="location_on" Path="locations" />
            <RadzenPanelMenuItem Text="Settings" Icon="settings" Path="settings" />
        </RadzenPanelMenu>
        <div class="sidebar-shapes">
            <BrandShape Kind="BrandShape.ShapeKind.Blob" Width="110" Style="left: 1.5rem; top: 1.5rem; transform: rotate(-24deg)" />
            <BrandShape Kind="BrandShape.ShapeKind.Bean" Width="84" Style="right: 1.75rem; top: 0.5rem" />
            <BrandShape Kind="BrandShape.ShapeKind.Seeds" Width="90" Style="right: 2.5rem; top: 7.5rem" />
        </div>
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _sidebarExpanded = true;
    private IJSObjectReference? _layout;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _layout = await JS.InvokeAsync<IJSObjectReference>("import", "./aperture.js");
        }
    }

    // On phones the sidebar is a full-screen menu: close it once a page is chosen.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_sidebarExpanded || _layout is null)
        {
            return;
        }

        try
        {
            if (await _layout.InvokeAsync<bool>("isNarrow"))
            {
                _sidebarExpanded = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; nothing to update.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_layout is not null)
        {
            try
            {
                await _layout.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
